#!/usr/bin/env bash
# cargo-candor — ergonomic wrapper around `cargo dylint` for the candor lint.
#
# One-time:  ./install.sh  (or `cargo candor setup`) — builds + puts `cargo candor` on PATH. Then e.g.
#   cargo candor audit              # at-a-glance effect profile of the whole project
#   cargo candor audit --all        # the full per-function lint (spans in context)
#   cargo candor snapshot .candor/baseline
#   cargo candor guard    .candor/baseline   # CI gate: fail on a gained effect
#   cargo candor diff     .candor/baseline   # describe the per-function effect delta (--json)
#   cargo candor watch                        # keep the report fresh in the background (fast `diff`)
#   cargo candor show     my_function         # a function's effects, INSTANT (read from the report)
#   cargo candor where    Net                 # which functions perform an effect, INSTANT
#   cargo candor callers  my_function         # which functions call this one, INSTANT (who depends on it)
#   cargo candor map                          # a module -> effects overview of the project, INSTANT
#   cargo candor explain  my_function        # trace WHY a function has each effect (the call path)
#   cargo candor policy   .candor/policy      # enforce effect boundaries (deny/pure rules)
#   cargo candor risk                         # heuristic: effects on caller-derived input (advisory)
#   cargo candor update
#   cargo candor strict   my_module
#   cargo candor no-ambient my_module
#
# It locates (building on first use) the toolchain-suffixed candor dylib and invokes
# `cargo dylint --lib-path <dylib>` with the right environment for the chosen command.
set -euo pipefail

# Resolve the candor clone — this script lives at its root (follow symlinks, e.g. from ~/.cargo/bin).
# Handle BOTH absolute and relative symlink targets (an absolute `ln -s` target must NOT be prefixed
# with the link's directory).
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  link="$(readlink "$SELF")"
  case "$link" in
    /*) SELF="$link" ;;
    *)  SELF="$(cd "$(dirname "$SELF")" && pwd)/$link" ;;
  esac
done
CANDOR_DIR="$(cd "$(dirname "$SELF")" && pwd)"
# Stable runtime home — the dylib + query binary are kept here so a `cargo clean` in the clone (or a
# toolchain bump that wipes target/) can't strand the tool. `install.sh` populates it.
CANDOR_CACHE="${CANDOR_CACHE:-$HOME/.candor}"
# Fallback if the wrapper was COPIED (not symlinked) somewhere with no clone alongside it.
if [ ! -f "$CANDOR_DIR/Cargo.toml" ] && [ -f "$CANDOR_CACHE/clone" ]; then
  CANDOR_DIR="$(cat "$CANDOR_CACHE/clone" 2>/dev/null || echo "$CANDOR_DIR")"
fi

# Locate the lint dylib among the clone's target/ and the stable ~/.candor/lib, preferring the NEWEST:
# a fresh clone build (candor's own development) must beat a stale cache, and after a `cargo clean` the
# cache copy is all that's left. Explicit mtime scan, NOT `ls … | head`: plain `ls` sorts operands
# alphabetically (so ~/.candor — `.candor` < `git`/`code`/… — would shadow a fresh build), and `ls -t`
# silently drops its time-sort once any operand doesn't exist (no release build, no `.so` on macOS —
# the usual case), returning the OLDEST. Non-matching globs stay literal under bash; `[ -e ]` skips them.
find_lib() {
  local newest="" f
  for f in "$CANDOR_DIR"/target/release/libcandor@*.dylib "$CANDOR_DIR"/target/release/libcandor@*.so \
           "$CANDOR_DIR"/target/debug/libcandor@*.dylib   "$CANDOR_DIR"/target/debug/libcandor@*.so \
           "$CANDOR_CACHE"/lib/libcandor@*.dylib          "$CANDOR_CACHE"/lib/libcandor@*.so; do
    [ -e "$f" ] || continue
    if [ -z "$newest" ] || [ "$f" -nt "$newest" ]; then newest="$f"; fi
  done
  [ -n "$newest" ] && printf '%s\n' "$newest"
}
# Mirror the active artifact into the stable home so a later `cargo clean` can't strand it. Idempotent:
# only copies when the source is newer than (or absent from) the cache, so it's cheap to call on every
# query invocation — no redundant cp when nothing changed.
stash() { # <file> <subdir>
  case "$1" in "$CANDOR_CACHE"/*) return 0 ;; esac
  [ -n "$1" ] || return 0
  local dest="$CANDOR_CACHE/$2/$(basename -- "$1")"
  if [ "$1" -nt "$dest" ]; then
    mkdir -p "$CANDOR_CACHE/$2" && cp -f "$1" "$dest" 2>/dev/null || true
  fi
}

# The read-only report queries (show/where/callers/map/diff/audit) live in the candor-query binary.
# Newest wins, via the same explicit mtime scan as find_lib (a fresh clone build must beat a stale cache).
find_query() {
  local newest="" f
  for f in "$CANDOR_DIR"/target/release/candor-query "$CANDOR_DIR"/target/debug/candor-query \
           "$CANDOR_CACHE"/bin/candor-query; do
    [ -e "$f" ] || continue
    if [ -z "$newest" ] || [ "$f" -nt "$newest" ]; then newest="$f"; fi
  done
  [ -n "$newest" ] && printf '%s\n' "$newest"
}
query() {
  local q; q="$(find_query || true)"
  if [ -z "$q" ]; then
    echo "candor: building candor-query (first run)…" >&2
    ( cd "$CANDOR_DIR" && cargo build -p candor-query >&2 )
    q="$(find_query || true)"
  fi
  [ -n "$q" ] || { echo "candor: could not build/find candor-query (run: $CANDOR_DIR/install.sh)" >&2; exit 1; }
  stash "$q" bin
  "$q" "$@"
}

# Cargo invokes external subcommands as `cargo-candor candor …`; drop the leading word.
[ "${1:-}" = "candor" ] && shift
cmd="${1:-audit}"; shift || true

# Resolve (building on first use) the lint dylib — UNLESS the command doesn't need it. `setup` is the
# recovery path (it builds cleanly via install.sh), and help is free; neither should fail on a missing
# or broken dylib first.
case "$cmd" in
  setup|install|-h|--help|help) LIB="" ;;
  *)
    LIB="$(find_lib || true)"
    if [ -z "${LIB:-}" ]; then
      echo "candor: building the lint (first run; rustup may fetch the pinned toolchain once)…" >&2
      ( cd "$CANDOR_DIR" && cargo build >&2 )
      LIB="$(find_lib || true)"
    fi
    [ -n "${LIB:-}" ] || {
      echo "candor: could not build/find the lint dylib — run: $CANDOR_DIR/install.sh" >&2
      exit 1
    }
    stash "$LIB" lib ;;
esac

# The candor commit that produced (or is checking) a baseline. A baseline is only comparable to
# itself — see `guard` and `update` below. Read the version the DYLIB was actually built at (the
# tag build.rs embedded), NOT the source tree's git HEAD: those diverge after `git pull` without a
# rebuild, and a HEAD-based check would then call a stale engine "current" and mask a stale
# baseline. Fall back to HEAD only if the tag can't be read (e.g. no `strings`).
engine_ver() {
  local v
  # The dylib's OWN stamp is authoritative — including the literal `unknown` build.rs writes when git
  # was absent at build time. Match `[0-9a-zA-Z]+` (not just hex) so `candor-build-version=unknown` is
  # returned as-is, rather than falling through to the source HEAD below — that fallback reintroduces
  # the very "pulled-but-not-rebuilt source diverges from the running dylib" masking build.rs avoids.
  v="$(strings -a "$LIB" 2>/dev/null | grep -oE 'candor-build-version=[0-9a-zA-Z]+' | head -1 | cut -d= -f2)"
  [ -n "$v" ] && { printf '%s' "$v"; return 0; }
  # Only when there's NO readable tag at all (no `strings`, a fully stripped binary) do we last-resort
  # to source HEAD — there's nothing better to report.
  git -C "$CANDOR_DIR" rev-parse --short HEAD 2>/dev/null
}

# Ensure `.candor/report.*` exists for a read-only query, INSTANTLY when possible: serve whatever is
# there (kept fresh by `cargo candor watch` or the Stop hook), generating one only if none exists.
# Warns when the report is behind the current source — the answer is still served, just flagged.
ensure_report() {
  if ! ls .candor/report.*.*.json >/dev/null 2>&1; then
    echo "candor: no report yet — generating one (run 'cargo candor watch &' to keep it fresh)…" >&2
    mkdir -p .candor                                   # fresh project: the lint can't create its output dir
    rm -rf target/dylint 2>/dev/null || true
    CANDOR_JSON="$PWD/.candor/report" cargo dylint --lib-path "$LIB" >/dev/null 2>&1 || true
    ls .candor/report.*.*.json >/dev/null 2>&1 || { echo "candor: could not produce a report (build failed?)." >&2; return 1; }
    # Stamp state at generation so the staleness check below can actually fire on a later run. Without
    # this, the no-watcher path (generate once, never write state) served a stale report SILENTLY after
    # any edit, because the `elif` requires a state file to compare against.
    find "$PWD" -name '*.rs' -not -path '*/target/*' -not -path '*/.git/*' -print0 2>/dev/null \
      | sort -z | xargs -0 shasum 2>/dev/null | shasum 2>/dev/null | cut -d' ' -f1 > .candor/state
  elif [ -f .candor/state ]; then
    local cur
    cur="$(find "$PWD" -name '*.rs' -not -path '*/target/*' -not -path '*/.git/*' -print0 2>/dev/null \
           | sort -z | xargs -0 shasum 2>/dev/null | shasum 2>/dev/null | cut -d' ' -f1)"
    [ -n "$cur" ] && [ "$cur" != "$(cat .candor/state 2>/dev/null)" ] && \
      echo "candor: ⚠ report may be behind your edits — 'cargo candor watch &' (or /candor) to refresh." >&2
  fi
  return 0
}

# Run the lint with the given env, INCREMENTALLY: a forced re-lint only recompiles the changed
# crate. dylint emits only when the lint runs, so if cargo had nothing to recompile (a pure cache
# hit — no "Checking"/"Compiling" line) the diagnostics would be missing; in that case, and only
# then, clear target/dylint and re-run. Avoids the full-tree rebuild a blind `rm -rf` forces.
#   usage: out="$(lint_fresh CANDOR_POLICY="$pol")"
lint_fresh() {
  local out
  out="$(env "$@" cargo dylint --lib-path "$LIB" 2>&1 || true)"
  if ! printf '%s' "$out" | grep -qE '^ *(Compiling|Checking) '; then
    rm -rf target/dylint 2>/dev/null || true
    out="$(env "$@" cargo dylint --lib-path "$LIB" 2>&1 || true)"
  fi
  printf '%s' "$out"
}

case "$cmd" in
  audit)
    # `--all`/`-a` → the full per-function lint: the dylint-native view, spans in context.
    # `--coverage`/`-c` → also list every external crate candor has no effect rules for (blind spots).
    # Default → an at-a-glance profile (candor-query), aggregated across the project's crates.
    if [ "${1:-}" = "--all" ] || [ "${1:-}" = "-a" ]; then
      exec cargo dylint --lib-path "$LIB"
    fi
    cov=""; { [ "${1:-}" = "--coverage" ] || [ "${1:-}" = "-c" ]; } && cov="--coverage"
    tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
    echo "candor: analyzing…" >&2
    run_json() { CANDOR_JSON="$tmp/a" cargo dylint --lib-path "$LIB" >/dev/null 2>&1 || true; }
    run_json
    # dylint emits only on recompile; if nothing was written the build was cached — force it once.
    ls "$tmp"/a.*.*.json >/dev/null 2>&1 || { rm -rf target/dylint 2>/dev/null || true; run_json; }
    if ! ls "$tmp"/a.*.*.json >/dev/null 2>&1; then
      echo "candor: no report produced — did the crate build? Try 'cargo candor audit --all' to see errors." >&2
      exit 1
    fi
    query audit "$tmp/a" "$(engine_ver)" "$CANDOR_DIR/candor-suspect" $cov
    exit 0 ;;
  strict)     export CANDOR_STRICT="${1:-1}";      exec cargo dylint --lib-path "$LIB" ;;
  no-ambient) export CANDOR_NO_AMBIENT="${1:-1}";  exec cargo dylint --lib-path "$LIB" ;;

  snapshot)
    # Write the baseline AND stamp the engine version beside it, so the guard later
    # knows which candor produced it.
    pre="${1:-.candor/baseline}"
    mkdir -p "$(dirname "$pre")"
    # dylint emits the report ONLY when the crate recompiles. A warm `target/dylint` (e.g. a prior
    # `cargo candor audit` in the same session) would otherwise produce ZERO baseline files while
    # snapshot still stamped a version and reported success — an EMPTY baseline silently disables the
    # guard. Force the recompile, then verify the files actually appeared.
    rm -rf target/dylint 2>/dev/null || true
    CANDOR_JSON="$pre" cargo dylint --lib-path "$LIB"
    if ! ls "$pre".*.*.json >/dev/null 2>&1; then
      echo "candor: snapshot produced NO report files — did the crate build? Baseline NOT written." >&2
      exit 1
    fi
    engine_ver > "$pre.candor-version"
    rm -f "$(dirname "$pre")/review-seen" 2>/dev/null || true   # new baseline → reset §2 self-review
    echo "candor: baseline written and stamped @$(cat "$pre.candor-version" 2>/dev/null)." >&2
    exit 0 ;;

  guard)
    # A baseline is only valid for the candor version that made it. If the engine has
    # moved on, a richer classifier would report effects the old snapshot never saw —
    # which is NOT a code regression. So on a version mismatch we SKIP enforcement (never
    # false-fire) and tell the user how to refresh; `cargo candor update` does it for them.
    pre="${1:-.candor/baseline}"
    ev="$(engine_ver)"; bv=""
    [ -f "$pre.candor-version" ] && bv="$(cat "$pre.candor-version" 2>/dev/null)"
    if [ -n "$bv" ] && [ "$bv" != "$ev" ]; then
      echo "candor: baseline is @$bv but the engine is @$ev — a tool upgrade is not a code" >&2
      echo "candor: regression, so effect enforcement is SKIPPED this run. Refresh it with" >&2
      echo "candor: 'cargo candor update' (or 'cargo candor snapshot $pre') here, then commit." >&2
      exit 0
    fi
    # dylint emits AS-EFF-005 only when the crate recompiles, so a warm `target/dylint` (a prior
    # audit/diff in the same job) would emit NOTHING and the guard would FAIL OPEN — passing a real
    # regression. Force the recompile so the lint actually runs over the code.
    rm -rf target/dylint 2>/dev/null || true
    if out="$(CANDOR_BASELINE="$pre" cargo dylint --lib-path "$LIB" 2>&1)"; then
      printf '%s\n' "$out" >&2
    else
      # dylint itself failed (the crate didn't build) — the guard could NOT run, so do not pass silently.
      printf '%s\n' "$out" >&2
      echo "candor: guard could NOT run (the crate failed to build under dylint) — failing closed, not a pass." >&2
      exit 2
    fi
    if printf '%s' "$out" | grep -q 'AS-EFF-005'; then
      echo "candor: a function GAINED an effect vs the baseline (AS-EFF-005) — blocked. Bypass: git push --no-verify" >&2
      exit 1
    fi
    exit 0 ;;

  diff)
    # The agent-facing sibling of `guard`: instead of pass/fail, DESCRIBE the per-function effect
    # delta vs the baseline — what each function gained or lost. This is the signal an agent can't
    # cheaply self-compute (transitive effects across the call graph). `--json` for machine reading.
    json=0; pre=".candor/baseline"
    for a in "$@"; do case "$a" in --json) json=1 ;; -*) ;; *) pre="$a" ;; esac; done
    if ! ls "$pre".*.*.json >/dev/null 2>&1; then
      echo "candor: no baseline at '$pre.*' — create one with 'cargo candor snapshot $pre'." >&2
      exit 2
    fi
    # FAST PATH: if the Stop hook (or `cargo candor watch`) already kept .candor/report.* fresh for
    # the CURRENT source, diff it directly — no recompile. The freshness test matches candor-run.sh's
    # src_hash exactly (find *.rs under $PWD, content-hash, compare to .candor/state). Content-based,
    # so a stale report can never be mistaken for fresh; a mismatch just falls back to the slow path.
    cur=""; rp=".candor/report"
    if ls "$rp".*.*.json >/dev/null 2>&1 && [ -f .candor/state ]; then
      cur_hash="$(find "$PWD" -name '*.rs' -not -path '*/target/*' -not -path '*/.git/*' -print0 2>/dev/null \
                  | sort -z | xargs -0 shasum 2>/dev/null | shasum 2>/dev/null | cut -d' ' -f1)"
      [ -n "$cur_hash" ] && [ "$cur_hash" = "$(cat .candor/state 2>/dev/null)" ] && cur="$rp"
    fi
    if [ -z "$cur" ]; then
      # SLOW PATH: re-lint to a temp prefix (no fresh report available).
      tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
      [ "$json" = 1 ] || echo "candor: analyzing…" >&2
      run_json() { CANDOR_JSON="$tmp/cur" cargo dylint --lib-path "$LIB" >/dev/null 2>&1 || true; }
      run_json
      ls "$tmp"/cur.*.*.json >/dev/null 2>&1 || { rm -rf target/dylint 2>/dev/null || true; run_json; }
      if ! ls "$tmp"/cur.*.*.json >/dev/null 2>&1; then
        echo "candor: no current report produced — did the crate build? Try 'cargo candor audit --all'." >&2
        exit 1
      fi
      cur="$tmp/cur"
    fi
    bv=""; [ -f "$pre.candor-version" ] && bv="$(cat "$pre.candor-version" 2>/dev/null)"
    query diff "$cur" "$pre" "$json" "$bv" "$(engine_ver)"
    exit 0 ;;

  watch)
    # Keep .candor/report.* fresh in the BACKGROUND so `cargo candor diff` (and the receipt) hit their
    # fast path — the compile then happens concurrently with editing, OFF the agent's critical path.
    # Polls the source hash (identically to candor-run.sh) every CANDOR_WATCH_INTERVAL s (default 2)
    # and re-lints on a real change. Long-running: run it in a side terminal, or `cargo candor watch &`.
    command -v shasum >/dev/null 2>&1 || { echo "candor: watch needs shasum" >&2; exit 2; }
    mkdir -p .candor
    sh_hash() { find "$PWD" -name '*.rs' -not -path '*/target/*' -not -path '*/.git/*' -print0 2>/dev/null \
                | sort -z | xargs -0 shasum 2>/dev/null | shasum 2>/dev/null | cut -d' ' -f1; }
    last=""; cleared=0
    if [ -f .candor/state ] && ls .candor/report.*.*.json >/dev/null 2>&1 && [ "$(sh_hash)" = "$(cat .candor/state 2>/dev/null)" ]; then
      last="$(sh_hash)"; cleared=1   # warm cache, report already fresh
      echo "candor: report already fresh — watching $PWD (Ctrl-C to stop)…" >&2
    else
      echo "candor: watching $PWD for Rust changes (Ctrl-C to stop)…" >&2
    fi
    while true; do
      cur="$(sh_hash)"
      if [ -n "$cur" ] && [ "$cur" != "$last" ]; then
        [ "$cleared" = 0 ] && { rm -rf target/dylint 2>/dev/null || true; cleared=1; }   # cold cache → force the first emit
        if CANDOR_JSON="$PWD/.candor/report" cargo dylint --lib-path "$LIB" >/dev/null 2>&1 \
           && ls .candor/report.*.*.json >/dev/null 2>&1; then
          echo "$cur" > .candor/state                      # stamp ONLY on a successful build → fresh
          echo "candor: report fresh @${cur:0:8}" >&2
        else
          echo "candor: build failed / no report — state left stale; retrying on next change" >&2
        fi
        last="$cur"
      fi
      sleep "${CANDOR_WATCH_INTERVAL:-2}"
    done ;;

  show)
    # INSTANT: a function's effect surface, read from the fresh report (no recompile). Replaces the
    # agent reading source to answer "what does this function do?". `--json` for machine reading.
    json=0; q=""
    for a in "$@"; do case "$a" in --json) json=1 ;; -*) ;; *) [ -z "$q" ] && q="$a" ;; esac; done
    [ -n "$q" ] || { echo "usage: cargo candor show <function-name-substring> [--json]" >&2; exit 2; }
    ensure_report || exit 1
    query show .candor/report "$q" "$json"
    exit 0 ;;

  where)
    # INSTANT: which functions perform an effect, read from the fresh report (no recompile). Replaces
    # grepping the codebase for "what touches the network/DB/…". Splits sources from inheritors.
    json=0; eff=""
    for a in "$@"; do case "$a" in --json) json=1 ;; -*) ;; *) [ -z "$eff" ] && eff="$a" ;; esac; done
    [ -n "$eff" ] || { echo "usage: cargo candor where <Effect> [--json]   (Net|Fs|Db|Exec|Env|Clock|Ipc|Log|Rand|Clipboard|Unknown)" >&2; exit 2; }
    ensure_report || exit 1
    query where .candor/report "$eff" "$json"
    exit 0 ;;

  callers)
    # INSTANT: which functions directly call <fn>, read from the report's (effect-relevant) call
    # graph — replaces grepping the codebase for callers before you edit. Substring match on the name.
    json=0; q=""
    for a in "$@"; do case "$a" in --json) json=1 ;; -*) ;; *) [ -z "$q" ] && q="$a" ;; esac; done
    [ -n "$q" ] || { echo "usage: cargo candor callers <function-name-substring> [--json]" >&2; exit 2; }
    ensure_report || exit 1
    query callers .candor/report "$q" "$json"
    exit 0 ;;

  map)
    # INSTANT: a compact module -> effects overview of the whole project, read from the report. Load
    # it once at the start of a session to understand the codebase's effect structure without grepping.
    json=0; for a in "$@"; do [ "$a" = "--json" ] && json=1; done
    ensure_report || exit 1
    query map .candor/report "$json"
    exit 0 ;;

  explain)
    # Trace WHY a function has each effect: the call path from it to the source of each effect (the
    # leaf call + location). `<query>` is a substring of the fully-qualified function name.
    q="${1:-}"
    [ -n "$q" ] || { echo "usage: cargo candor explain <function-name-substring>" >&2; exit 2; }
    lint_fresh CANDOR_EXPLAIN="$q" \
      | grep -vaE '^ *(Checking|Compiling|Finished|Building|Blocking|Locking|Updating|Downloading|Downloaded|Fresh) ' \
      | grep -vaE '^(warning|error)[:[]' \
      | grep -vaE 'generated [0-9]+ warning'
    exit 0 ;;

  policy)
    # Enforce declared effect boundaries (default .candor/policy). Fails (exit 1) on AS-EFF-006 (a
    # function that *transitively* performs an effect a rule forbids — e.g. domain code reaching the
    # network through a helper) or AS-EFF-008 (a function in scope reaching a Net host outside its
    # declared allowlist, or an endpoint candor can't pin down). Rules: `deny <Effects...> [scope]`,
    # `pure [scope]`, `allow Net [in <scope>] <host>...`; scope = a path substring. This is the
    # architectural-invariant gate an agent can't self-check.
    pol="${1:-.candor/policy}"
    [ -f "$pol" ] || { echo "candor: no policy at '$pol'. Rules: 'deny Net Db domain', 'pure parse', 'allow Net in billing api.stripe.com'." >&2; exit 2; }
    out="$(lint_fresh CANDOR_POLICY="$pol")"
    printf '%s\n' "$out" | grep -aE '\[AS-EFF-006\]|\[AS-EFF-008\]' >&2 || true
    if printf '%s' "$out" | grep -qE 'AS-EFF-006|AS-EFF-008'; then
      echo "candor: effect-policy violation (AS-EFF-006/008) — blocked. Bypass: git push --no-verify" >&2
      exit 1
    fi
    echo "candor: policy OK — no boundary violations." >&2
    exit 0 ;;

  risk)
    # Heuristic: flag injection-class effects (Fs/Exec/Db/Net/Env/Ipc) performed on a PARAMETER-derived
    # argument — path traversal / command injection / SSRF. ADVISORY (exit 0): an intraprocedural,
    # syntactic nudge, NOT sound taint analysis — it over- and under-flags. Review it, don't gate on it.
    out="$(lint_fresh CANDOR_TAINT=1)"
    if printf '%s' "$out" | grep -q 'AS-EFF-007'; then
      printf '%s\n' "$out" | grep -aE '\[AS-EFF-007\]' >&2
      echo "candor: ^ heuristic review nudges (caller-derived effect arguments) — not a gate." >&2
    else
      echo "candor: no caller-derived effect arguments found (heuristic)." >&2
    fi
    exit 0 ;;

  update)
    # The clone is the single source of truth for the engine, the Claude Code integration
    # scripts, and AGENTS.md — pull + rebuild updates all three at one commit.
    echo "candor: updating $CANDOR_DIR …" >&2
    ( cd "$CANDOR_DIR" && git pull --ff-only ) >&2
    # One build+stash+symlink path, shared with `setup` — don't re-implement it here.
    "$CANDOR_DIR/install.sh" >&2
    LIB="$(find_lib || true)"; ev="$(engine_ver)"
    echo "candor: engine now @$ev — scripts and AGENTS.md current too." >&2
    # Invalidate the cached read-only query report: it was produced by the OLD engine, but `.candor/state`
    # still matches the (unchanged) source, so the query/diff fast-path would serve a stale-engine report
    # against the new-engine baseline → spurious reclassification deltas. Clearing it forces a rebuild
    # with the new engine on next use.
    rm -f .candor/report.*.*.json .candor/state 2>/dev/null || true
    # Auto-refresh a baseline in THIS project so the guard never false-fires after an
    # upgrade. Force a recompile (dylint emits only on recompile), regenerate, re-stamp.
    if ls .candor/baseline.*.json >/dev/null 2>&1; then
      pre=".candor/baseline"
      old="$(cat "$pre".*.json 2>/dev/null | shasum 2>/dev/null | cut -d' ' -f1)"
      find . -path ./target -prune -o -name '*.rs' -print0 2>/dev/null | xargs -0 touch 2>/dev/null || true
      if CANDOR_JSON="$pre" cargo dylint --lib-path "$LIB" >/dev/null 2>&1 && ls "$pre".*.json >/dev/null 2>&1; then
        echo "$ev" > "$pre.candor-version"
        rm -f "$(dirname "$pre")/review-seen" 2>/dev/null || true   # new baseline → reset §2 self-review
        new="$(cat "$pre".*.json 2>/dev/null | shasum 2>/dev/null | cut -d' ' -f1)"
        if [ "$old" = "$new" ]; then
          echo "candor: baseline content UNCHANGED (this engine classifies it identically) — re-stamped @$ev, nothing to review." >&2
        else
          echo "candor: baseline CHANGED under @$ev — the new engine detects different effects here." >&2
          echo "candor: review 'git diff .candor/' and commit it (this is the upgrade's doing, not a code change)." >&2
        fi
      else
        echo "candor: this project didn't compile — baseline NOT refreshed; the guard stays fail-open" >&2
        echo "candor: (and says so at push) until it builds and you re-run this." >&2
      fi
    else
      echo "candor: (no guard baseline in $PWD — run from a project dir to refresh that project's baseline)" >&2
    fi
    exit 0 ;;

  setup|install)
    # One-shot: build, stash the dylib + query binary in ~/.candor (survives `cargo clean`), and put
    # `cargo candor` on PATH via ~/.cargo/bin. Re-run any time to refresh.
    exec "$CANDOR_DIR/install.sh" "$@" ;;

  -h|--help|help)
    sed -n '2,19p' "$SELF" | sed 's/^# \{0,1\}//'
    exit 0 ;;
  *)
    echo "candor: unknown command '$cmd' (setup|audit|snapshot|guard|diff|watch|show|where|callers|map|explain|policy|risk|strict|no-ambient|update)" >&2
    exit 2 ;;
esac
