#!/usr/bin/env bash
# cargo-candor — ergonomic wrapper around `cargo dylint` for the candor lint.
#
# One-time:  ./install.sh  (or `cargo candor setup`) — builds + puts `cargo candor` on PATH. Then e.g.
#   cargo candor scan               # STABLE backend: produce the report on stock cargo (no nightly)
#   cargo candor audit              # at-a-glance effect profile of the whole project (nightly lint)
#   cargo candor audit --all        # the full per-function lint (spans in context)
#   cargo candor snapshot .candor/baseline
#   cargo candor guard    .candor/baseline   # CI gate: fail on a gained effect
#   cargo candor diff     .candor/baseline   # describe the per-function effect delta (--json)
#   cargo candor watch                        # keep the report fresh in the background (fast `diff`)
#   cargo candor show     my_function         # a function's effects, INSTANT (read from the report)
#   cargo candor where    Net                 # which functions perform an effect, INSTANT
#   cargo candor callers  my_function         # which functions call this one, INSTANT (who depends on it)
#   cargo candor whatif   my_function Net      # PRE-EDIT: if I add Net here, what propagates + does it break policy?
#   cargo candor rewire   <baseline-prefix>    # did a 'fix' DE-WIRE the feature to pass the gate? (run with policy)
#   cargo candor map                          # a module -> effects overview of the project, INSTANT
#   cargo candor containment [baseline]       # effect-leakage diagnostic; with a baseline, a CI ratchet
#   cargo candor reachable                    # what the program does at runtime (union over entry points)
#   cargo candor path     my_function Net     # the call chain by which a fn comes to perform an effect, INSTANT
#   cargo candor explain  my_function        # trace WHY a function has each effect (the call path)
#   cargo candor policy   .candor/policy      # enforce effect boundaries (deny/pure rules)
#   cargo candor risk                         # heuristic: effects on caller-derived input (advisory)
#   cargo candor update
#   cargo candor strict   my_module
#   cargo candor no-ambient my_module
#
# It locates (building on first use) the toolchain-suffixed candor dylib and invokes
# `cargo dylint --lib-path <dylib>` with the right environment for the chosen command.
set -euo pipefail

# Resolve the candor clone — this script lives at its root (follow symlinks, e.g. from ~/.cargo/bin).
# Handle BOTH absolute and relative symlink targets (an absolute `ln -s` target must NOT be prefixed
# with the link's directory).
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  link="$(readlink "$SELF")"
  case "$link" in
    /*) SELF="$link" ;;
    *)  SELF="$(cd "$(dirname "$SELF")" && pwd)/$link" ;;
  esac
done
CANDOR_DIR="$(cd "$(dirname "$SELF")" && pwd)"
# Stable runtime home — the dylib + query binary are kept here so a `cargo clean` in the clone (or a
# toolchain bump that wipes target/) can't strand the tool. `install.sh` populates it.
CANDOR_CACHE="${CANDOR_CACHE:-$HOME/.candor}"
# Fallback if the wrapper was COPIED (not symlinked) somewhere with no clone alongside it.
if [ ! -f "$CANDOR_DIR/Cargo.toml" ] && [ -f "$CANDOR_CACHE/clone" ]; then
  CANDOR_DIR="$(cat "$CANDOR_CACHE/clone" 2>/dev/null || echo "$CANDOR_DIR")"
fi

# Newest of the given candidate files by mtime — the ONE locator primitive (was copied into find_lib/
# find_query/find_scan). Explicit mtime scan, NOT `ls … | head`: plain `ls` sorts alphabetically (so a
# stale-toolchain `libcandor@nightly-2025-…` would shadow a fresh `…2026-…` build), and `ls -t` drops
# its time-sort once any operand is missing. Non-matching globs stay literal under bash; `[ -e ]` skips.
newest_of() {
  local newest="" f
  for f in "$@"; do
    [ -e "$f" ] || continue
    if [ -z "$newest" ] || [ "$f" -nt "$newest" ]; then newest="$f"; fi
  done
  [ -n "$newest" ] && printf '%s\n' "$newest"
}
# The lint dylib (newest across the clone's target/ and the stable ~/.candor/lib).
find_lib() {
  newest_of "$CANDOR_DIR"/target/release/libcandor@*.dylib "$CANDOR_DIR"/target/release/libcandor@*.so \
            "$CANDOR_DIR"/target/debug/libcandor@*.dylib   "$CANDOR_DIR"/target/debug/libcandor@*.so \
            "$CANDOR_CACHE"/lib/libcandor@*.dylib          "$CANDOR_CACHE"/lib/libcandor@*.so
}
# Mirror the active artifact into the stable home so a later `cargo clean` can't strand it. Idempotent:
# only copies when the source is newer than (or absent from) the cache, so it's cheap to call on every
# query invocation — no redundant cp when nothing changed.
stash() { # <file> <subdir>
  case "$1" in "$CANDOR_CACHE"/*) return 0 ;; esac
  [ -n "$1" ] || return 0
  local dest="$CANDOR_CACHE/$2/$(basename -- "$1")"
  if [ "$1" -nt "$dest" ]; then
    mkdir -p "$CANDOR_CACHE/$2" && cp -f "$1" "$dest" 2>/dev/null || true
  fi
}

# candor-query (the read-only/orchestration Rust binary) — the bootstrap locator: bash MUST find this
# before it can delegate the rest (backend detection, report-clearing, version-stamp, locate) to it.
find_query() {
  newest_of "$CANDOR_DIR"/target/release/candor-query "$CANDOR_DIR"/target/debug/candor-query \
            "$CANDOR_CACHE"/bin/candor-query
}
# The STABLE backend (candor-scan) binary.
find_scan() {
  newest_of "$CANDOR_DIR"/target/release/candor-scan "$CANDOR_DIR"/target/debug/candor-scan \
            "$CANDOR_CACHE"/bin/candor-scan
}
query() {
  local q; q="$(find_query || true)"
  if [ -z "$q" ]; then
    echo "candor: building candor-query (first run)…" >&2
    ( cd "$CANDOR_DIR" && cargo build -p candor-query >&2 )
    q="$(find_query || true)"
  fi
  [ -n "$q" ] || { echo "candor: could not build/find candor-query (run: $CANDOR_DIR/install.sh)" >&2; exit 1; }
  stash "$q" bin
  "$q" "$@"
}
scan_run() {
  local s; s="$(find_scan || true)"
  if [ -z "$s" ]; then
    echo "candor: building candor-scan (first run; stable Rust, no nightly)…" >&2
    ( cd "$CANDOR_DIR" && cargo build -p candor-scan >&2 )
    s="$(find_scan || true)"
  fi
  [ -n "$s" ] || { echo "candor: could not build/find candor-scan (run: $CANDOR_DIR/install.sh)" >&2; exit 1; }
  stash "$s" bin
  "$s" "$@"
}

# The source-freshness key: a content hash of every `.rs` file under the project (excluding target/ &
# .git/), used to tell whether a saved report still matches the tree. ONE canonical implementation in
# candor-query (`state`), replacing the fragile `find … | shasum | shasum | cut` pipeline that was
# copy-pasted — and had drifted — across the wrapper and hooks. `query state` ignores its argv tail.
src_state() { query state 2>/dev/null; }

# Does a candor report exist for <prefix>? Uses candor-query's `reports --exists`, i.e. the EXACT
# `candor_report::report_files` semantics — so a sidecar (`.calibrated` / `.encountered-*` /
# `.layerreach`) is never counted as a report. The coarse `ls "$prefix".*.*.json` glob could: `*`
# matches dots, so a 3-segment `r.app.Executable.layerreach.json` matches `r.*.*.json`. Falls back to
# that glob only when the query binary isn't located yet, so it never breaks the wrapper.
# Delegate to candor-query if it's already located — NO build-on-demand, NO exit (unlike `query()`), so
# the read-only report helpers below degrade gracefully before the first build. The report-lifecycle
# logic (exists/backend/clear) now lives ONCE in candor-query (tested), not copy-pasted across scripts.
cq() { local q; q="$(find_query 2>/dev/null || true)"; [ -n "$q" ] && "$q" "$@"; }

report_exists() {
  local q; q="$(find_query 2>/dev/null || true)"
  if [ -n "$q" ]; then "$q" reports "$1" --exists; else ls "$1".*.*.json >/dev/null 2>&1; fi
}

# Which backend produced the report at <prefix>: `candor-query reports --backend` (reads report_files'
# exact kind, the single owner). Used to keep the lint and scan backends from being confused/mixed.
is_scan_report() { [ "$(cq reports "$1" --backend 2>/dev/null)" = scan ]; }

# Remove a stale STABLE-backend report for <prefix> (e.g. left by the Stop hook when no dylib was
# present) before the lint regenerates, so a lint report and a scan report never coexist under one
# prefix (which would double-count functions and let a diff/receipt read a mix). `--clear-other lint`
# keeps the lint's files (incl. its last-good report on a build failure) and drops only the scan ones.
clear_scan_reports() { cq reports "$1" --clear-other lint >/dev/null 2>&1 || true; }

# ── .candor/config (candor-spec §3.4): the checked-in floor under the CANDOR_* env wiring ──────────
# Discovery is anchored to the project being analyzed: walk UP from $PWD to the nearest
# `.candor/config`; a set $CANDOR_CONFIG overrides discovery entirely. Grammar matches candor-scan's
# exactly (`#` begins a comment, inline too; first token = key, ASCII-lowercased; rest of line =
# value). The wrapper wires the keys its commands consume — `policy` (the `policy` command's default
# file), `baseline` (the guard/diff/snapshot default prefix), `deps` (exported as CANDOR_DEPS when the
# env doesn't already set it) — and DISCLOSES the recognized keys it does not wire (a checked-in
# `strict` that silently does nothing here would be a declared-gate-silently-off). Precedence, highest
# first: CLI arg → the matching CANDOR_* env var → this file → the built-in default.
# FAIL-CLOSED: a configured-but-unusable config exits 2 (it may carry the policy, so silently dropping
# it is silently dropping a gate); unknown keys warn. A RELATIVE path value resolves against the
# CONFIG FILE'S directory (the family decision — the config is checked in and travels with the code),
# never the process CWD.
CFG_POLICY=""; CFG_BASELINE=""
load_config() {
  local f="" d text line key val cfgdir
  if [ -n "${CANDOR_CONFIG:-}" ]; then
    f="$CANDOR_CONFIG"
    if [ ! -f "$f" ] || [ ! -r "$f" ]; then
      echo "candor: CANDOR_CONFIG=$f is not a readable file — failing closed (exit 2)." >&2
      exit 2
    fi
  else
    d="$PWD"
    while :; do
      [ -e "$d/.candor/config" ] && { f="$d/.candor/config"; break; }
      [ "$d" = "/" ] && break
      d="$(dirname "$d")"
    done
  fi
  [ -n "$f" ] || return 0
  if ! text="$(cat "$f" 2>/dev/null)"; then
    echo "candor: config $f exists but could not be read — failing closed (exit 2)." >&2
    exit 2
  fi
  cfgdir="$(cd "$(dirname "$f")" && pwd)"
  rel() { case "$1" in ""|/*) printf '%s' "$1" ;; *) printf '%s/%s' "$cfgdir" "$1" ;; esac; }
  while IFS= read -r line; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"; line="${line%"${line##*[![:space:]]}"}"   # trim
    [ -n "$line" ] || continue
    key="${line%%[[:space:]]*}"
    val="${line#"$key"}"; val="${val#"${val%%[![:space:]]*}"}"
    key="$(printf '%s' "$key" | tr '[:upper:]' '[:lower:]')"
    case "$key" in
      policy)   CFG_POLICY="$(rel "$val")" ;;
      baseline) CFG_BASELINE="$(rel "$val")" ;;
      deps)
        if [ -z "${CANDOR_DEPS:-}" ] && [ -n "$val" ]; then
          local parts=() p out=""
          IFS=':' read -ra parts <<< "$val"
          for p in "${parts[@]}"; do out="$out:$(rel "$p")"; done
          export CANDOR_DEPS="${out#:}"
        fi ;;
      strict|no-ambient|closed-world|taint)
        echo "candor: config key '$key' is recognized by the candor family but not wired by" >&2
        echo "candor: cargo-candor — that mode is NOT active on this run (invoke its command" >&2
        echo "candor: explicitly, e.g. 'cargo candor strict/no-ambient/risk')." >&2 ;;
      *)
        echo "candor: ignoring unknown config key '$key' in $f" >&2 ;;
    esac
  done <<< "$text"
}

# Cargo invokes external subcommands as `cargo-candor candor …`; drop the leading word.
[ "${1:-}" = "candor" ] && shift
cmd="${1:-audit}"; shift || true

# `scan` delegates to candor-scan, which does its own §3.4 discovery (don't double-warn); setup/help
# must never fail on a broken config before they can help fix it.
case "$cmd" in
  setup|install|-h|--help|help|scan) : ;;
  *) load_config ;;
esac

# Resolve (building on first use) the lint dylib — UNLESS the command doesn't need it. `setup` is the
# recovery path (it builds cleanly via install.sh), and help is free; neither should fail on a missing
# or broken dylib first.
case "$cmd" in
  setup|install|-h|--help|help|scan) LIB="" ;;
  audit|show|where|callers|map|containment|reachable|path|impact)
    # Read-only queries: prefer the nightly lint (soundness, Unknown), but DON'T hard-fail without it —
    # fall back to the stable scanner so these work zero-install. Use an existing dylib if present; only
    # attempt a build when one's already around to refresh. If none, LIB stays empty and the command's
    # report path (ensure_report / audit) uses candor-scan instead.
    # `CANDOR_BACKEND=scan` forces the stable backend even when a dylib is present (CI/reproducibility).
    if [ "${CANDOR_BACKEND:-}" = "scan" ]; then
      LIB=""
    else
      LIB="$(find_lib || true)"
      [ -n "${LIB:-}" ] && stash "$LIB" lib
    fi ;;
  *)
    LIB="$(find_lib || true)"
    if [ -z "${LIB:-}" ]; then
      echo "candor: building the lint (first run; rustup may fetch the pinned toolchain once)…" >&2
      ( cd "$CANDOR_DIR" && cargo build >&2 )
      LIB="$(find_lib || true)"
    fi
    [ -n "${LIB:-}" ] || {
      echo "candor: could not build/find the lint dylib — run: $CANDOR_DIR/install.sh" >&2
      exit 1
    }
    stash "$LIB" lib ;;
esac

# The candor commit that produced (or is checking) a baseline. A baseline is only comparable to
# itself — see `guard` and `update` below. Read the version the DYLIB was actually built at (the
# tag build.rs embedded), NOT the source tree's git HEAD: those diverge after `git pull` without a
# rebuild, and a HEAD-based check would then call a stale engine "current" and mask a stale
# baseline. Fall back to HEAD only if the tag can't be read (e.g. no `strings`).
engine_ver() {
  local v
  # No lint dylib resolved → the report came from the STABLE scanner; stamp it `scan` so a reader (and
  # `cargo candor audit`'s header) can't mistake a syntactic report for the nightly lint at a git hash.
  [ -z "${LIB:-}" ] && { printf 'scan'; return 0; }
  # The dylib's OWN stamp is authoritative (`candor-query engine-version` reads the tag build.rs embedded
  # — portable, no `strings` dependency; includes the literal `unknown` build.rs writes without a git).
  v="$(cq engine-version "$LIB" 2>/dev/null)"
  [ -n "$v" ] && { printf '%s' "$v"; return 0; }
  # Only when there's NO readable tag (stripped binary, or candor-query not located) do we last-resort to
  # source HEAD — there's nothing better to report.
  git -C "$CANDOR_DIR" rev-parse --short HEAD 2>/dev/null
}

# Ensure `.candor/report.*` exists for a read-only query, INSTANTLY when possible: serve whatever is
# there (kept fresh by `cargo candor watch` or the Stop hook), generating one only if none exists.
# Warns when the report is behind the current source — the answer is still served, just flagged.
ensure_report() {
  if ! report_exists .candor/report; then
    echo "candor: no report yet — generating one (run 'cargo candor watch &' to keep it fresh)…" >&2
    mkdir -p .candor                                   # fresh project: the lint can't create its output dir
    if [ -n "${LIB:-}" ]; then
      rm -rf target/dylint 2>/dev/null || true
      CANDOR_JSON="$PWD/.candor/report" cargo dylint --lib-path "$LIB" >/dev/null 2>&1 || true
    else
      # No nightly dylib — zero-install fallback to the stable scanner. Same report JSON, no build.
      echo "candor: using the stable backend (candor-scan)." >&2
      scan_run "$PWD" --out "$PWD/.candor/report" >/dev/null 2>&1 || true
    fi
    report_exists .candor/report || { echo "candor: could not produce a report (build failed?)." >&2; return 1; }
    # Stamp state at generation so the staleness check below can actually fire on a later run. Without
    # this, the no-watcher path (generate once, never write state) served a stale report SILENTLY after
    # any edit, because the `elif` requires a state file to compare against.
    src_state > .candor/state
  elif [ -f .candor/state ]; then
    local cur
    cur="$(src_state)"
    [ -n "$cur" ] && [ "$cur" != "$(cat .candor/state 2>/dev/null)" ] && \
      echo "candor: ⚠ report may be behind your edits — 'cargo candor watch &' (or /candor) to refresh." >&2
  fi
  return 0
}

# Run the lint with the given env, INCREMENTALLY: a forced re-lint only recompiles the changed
# crate. dylint emits only when the lint runs, so if cargo had nothing to recompile (a pure cache
# hit — no "Checking"/"Compiling" line) the diagnostics would be missing; in that case, and only
# then, clear target/dylint and re-run. Avoids the full-tree rebuild a blind `rm -rf` forces.
#   usage: out="$(lint_fresh CANDOR_POLICY="$pol")"
lint_fresh() {
  local out
  out="$(env "$@" cargo dylint --lib-path "$LIB" 2>&1 || true)"
  if ! printf '%s' "$out" | grep -qE '^ *(Compiling|Checking) '; then
    rm -rf target/dylint 2>/dev/null || true
    out="$(env "$@" cargo dylint --lib-path "$LIB" 2>&1 || true)"
  fi
  printf '%s' "$out"
}

case "$cmd" in
  audit)
    # `--all`/`-a` → the full per-function lint: the dylint-native view, spans in context (lint only).
    # `--coverage`/`-c` → also list every external crate candor has no effect rules for (blind spots).
    # Default → an at-a-glance profile (candor-query), aggregated across the project's crates.
    if [ "${1:-}" = "--all" ] || [ "${1:-}" = "-a" ]; then
      [ -n "${LIB:-}" ] || { echo "candor: 'audit --all' is the nightly lint view; none found. Run 'cargo candor audit' for the stable profile, or install the lint." >&2; exit 1; }
      exec cargo dylint --lib-path "$LIB"
    fi
    cov=""; { [ "${1:-}" = "--coverage" ] || [ "${1:-}" = "-c" ]; } && cov="--coverage"
    tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
    echo "candor: analyzing…" >&2
    if [ -n "${LIB:-}" ]; then
      run_json() { CANDOR_JSON="$tmp/a" cargo dylint --lib-path "$LIB" >/dev/null 2>&1 || true; }
      run_json
      # dylint emits only on recompile; if nothing was written the build was cached — force it once.
      report_exists "$tmp/a" || { rm -rf target/dylint 2>/dev/null || true; run_json; }
    else
      # Zero-install: the stable scanner produces the same report JSON with no nightly toolchain.
      echo "candor: using the stable backend (candor-scan)." >&2
      # The stable backend writes no `.encountered`/`.calibrated` sidecars, so the coverage blind-spot
      # list would come back EMPTY — a false all-clear. Don't pass --coverage; say it's unavailable.
      [ -n "$cov" ] && { echo "candor: --coverage is unavailable on the stable backend (it needs the nightly lint's encountered-crate set)." >&2; cov=""; }
      scan_run "$PWD" --out "$tmp/a" >/dev/null 2>&1 || true
    fi
    if ! report_exists "$tmp/a"; then
      echo "candor: no report produced — did the crate build? Try 'cargo candor audit --all' to see errors." >&2
      exit 1
    fi
    # engine_ver returns `scan` on the stable backend now (never empty), so the audit header honestly
    # reads `@scan` rather than the clone's git hash — and the quoted slot can't collapse and shift argv.
    query audit "$tmp/a" "$(engine_ver)" "$CANDOR_DIR/candor-suspect" $cov
    exit 0 ;;
  strict)     export CANDOR_STRICT="${1:-1}";      exec cargo dylint --lib-path "$LIB" ;;
  no-ambient) export CANDOR_NO_AMBIENT="${1:-1}";  exec cargo dylint --lib-path "$LIB" ;;

  snapshot)
    # Write the baseline AND stamp the engine version beside it, so the guard later
    # knows which candor produced it.
    pre="${1:-${CANDOR_BASELINE:-${CFG_BASELINE:-.candor/baseline}}}"
    mkdir -p "$(dirname "$pre")"
    # dylint emits the report ONLY when the crate recompiles. A warm `target/dylint` (e.g. a prior
    # `cargo candor audit` in the same session) would otherwise produce ZERO baseline files while
    # snapshot still stamped a version and reported success — an EMPTY baseline silently disables the
    # guard. Force the recompile, then verify the files actually appeared.
    rm -rf target/dylint 2>/dev/null || true
    # candor writes its report in `check_crate_post` — BEFORE rustc flushes any `span_delayed_bug`s at
    # shutdown. So a NONZERO dylint exit alongside a COMPLETE report means a benign rustc shutdown
    # delayed-bug (e.g. a speculative `Instance::try_resolve` on a derive'd impl — which candor already
    # records as unresolved), NOT an analysis failure. Capture the exit (don't let `set -e` abort) and
    # let the report-existence check below be the real success gate.
    snap_rc=0
    CANDOR_JSON="$pre" cargo dylint --lib-path "$LIB" || snap_rc=$?
    if ! report_exists "$pre"; then
      echo "candor: snapshot produced NO report files — did the crate build? Baseline NOT written." >&2
      exit 1
    fi
    if [ "$snap_rc" -ne 0 ]; then
      echo "candor: note — rustc emitted a delayed-bug at shutdown (dylint exit $snap_rc), but the report is complete; the snapshot is valid. This is a benign rustc artifact of speculative resolution, not a candor analysis error." >&2
    fi
    engine_ver > "$pre.candor-version"
    rm -f "$(dirname "$pre")/review-seen" 2>/dev/null || true   # new baseline → reset §2 self-review
    echo "candor: baseline written and stamped @$(cat "$pre.candor-version" 2>/dev/null)." >&2
    exit 0 ;;

  guard)
    # A baseline is only valid for the candor version that made it (spec §2.1): a stale baseline is
    # INVALID GATE INPUT — the unreadable-policy class. Evaluating it would flood bogus AS-EFF-005s
    # (a richer classifier reports effects the old snapshot never saw — unmasking, not regression) with
    # any REAL regression hidden inside the wave; the old SKIP here was the other failure mode — an
    # unbounded fail-open window (CI green with the gate silently off until someone remembered to
    # refresh). The aligned family posture (candor-java matches): do NOT evaluate, say it once, exit 2.
    # Args: an optional baseline prefix + `--gate-json <path|->` (the §3.3 structured verdict, spec
    # ⟨0.8⟩ — same shape as candor-scan's flag; `-` streams it to stdout).
    pre=""; gjson=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --gate-json)
          shift
          { [ "$#" -gt 0 ] && { [ "$1" = "-" ] || [ "${1#-}" = "$1" ]; }; } \
            || { echo "candor: --gate-json requires a path argument" >&2; exit 2; }
          gjson="$1" ;;
        -*) echo "candor: unknown flag '$1' for guard" >&2; exit 2 ;;
        *)  pre="$1" ;;
      esac
      shift
    done
    [ -n "$pre" ] || pre="${CANDOR_BASELINE:-${CFG_BASELINE:-.candor/baseline}}"
    # The verdict target the ENGINE writes to (CANDOR_GATE_JSON; empty = not requested — the engine
    # ignores an empty var). `-` streams: the engine writes a temp file, the final assembly prints it.
    # Cleared UP FRONT so any exit-2 path below can never leave a STALE verdict from a previous run
    # lying around looking current (the §3.3 verdict/exit-code agreement).
    gate_target=""; gtmp=""
    if [ -n "$gjson" ]; then
      case "$gjson" in -|/*) ;; *) gjson="$PWD/$gjson" ;; esac
      gtmp="$(mktemp -d)"
      if [ "$gjson" = "-" ]; then gate_target="$gtmp/gate.json"; else gate_target="$gjson"; fi
      rm -f "$gate_target" "$gate_target.parts"
    fi
    # No baseline AT ALL (never snapshotted, a typo'd prefix) is the same invalid-gate-input class as a
    # stale one: the engine would warn "guard NOT active" and exit 0 — an unbounded fail-open window.
    # Fail closed with the incantation instead (review §2 gap).
    if ! report_exists "$pre"; then
      echo "candor: no baseline found at '$pre.*' — the guard cannot evaluate (never a silent pass)." >&2
      echo "candor: create one with 'cargo candor snapshot $pre', commit the baseline.* files, re-run." >&2
      exit 2
    fi
    ev="$(engine_ver)"; bv=""
    [ -f "$pre.candor-version" ] && bv="$(cat "$pre.candor-version" 2>/dev/null)"
    # Absent provenance is as unverifiable as a mismatch (§2.1) — if a baseline EXISTS but carries no
    # .candor-version sidecar, it predates stamping / was hand-made: fail closed too, not fail-open
    # (review gap: the old `[ -n "$bv" ]` guard silently evaluated a sidecar-less baseline).
    if [ -z "$bv" ] && ls "$pre".*.json >/dev/null 2>&1; then
      echo "candor: the baseline $pre has no .candor-version provenance sidecar — unverifiable (§2.1)." >&2
      echo "candor: Refresh with 'cargo candor snapshot $pre' (writes the sidecar), then commit both." >&2
      exit 2
    fi
    if [ -n "$bv" ] && [ "$bv" != "$ev" ]; then
      echo "candor: the baseline is @$bv but the engine is @$ev — an engine swap is" >&2
      echo "candor: baseline-invalidating, so the gate cannot evaluate (exit 2; never a silent skip," >&2
      echo "candor: never a bogus AS-EFF-005 wave). Refresh deliberately with 'cargo candor update'" >&2
      echo "candor: (or 'cargo candor snapshot $pre'), review the effect delta, then commit both." >&2
      exit 2
    fi
    # dylint emits AS-EFF-005 only when the crate recompiles, so a warm `target/dylint` (a prior
    # audit/diff in the same job) would emit NOTHING and the guard would FAIL OPEN — passing a real
    # regression. Force the recompile so the lint actually runs over the code.
    rm -rf target/dylint 2>/dev/null || true
    # Verdict via a MACHINE signal (CANDOR_VIOLATIONS), not by grepping the prose: the engine appends a
    # line per AS-EFF-005 gain, so a reworded message or a changed output stream can't turn the guard
    # green. Fresh file per run (the engine appends). The human diagnostics are still printed.
    vio="$(mktemp)"; trap 'rm -rf "$vio" ${gtmp:+"$gtmp"}' EXIT
    if out="$(CANDOR_BASELINE="$pre" CANDOR_VIOLATIONS="$vio" CANDOR_GATE_JSON="$gate_target" cargo dylint --lib-path "$LIB" 2>&1)"; then
      printf '%s\n' "$out" >&2
    else
      # dylint itself failed (the crate didn't build) — the guard could NOT run, so do not pass silently.
      printf '%s\n' "$out" >&2
      [ -n "$gate_target" ] && { rm -f "$gate_target" "$gate_target.parts"; echo "candor: --gate-json not written — the gate did not complete (exit 2)." >&2; }
      echo "candor: guard could NOT run (the crate failed to build under dylint) — failing closed, not a pass." >&2
      exit 2
    fi
    # A per-crate baseline gap (a NEW workspace member, a renamed crate — the prefix has files, but not
    # for this crate) is disclosed by the engine as a GUARD-UNAVAILABLE sentinel line: the guard could
    # not evaluate that crate, so it must NOT pass silently — exit 2 (not-evaluated), not 0 and not a
    # bogus AS-EFF-005.
    if grep -q '^GUARD-UNAVAILABLE ' "$vio" 2>/dev/null; then
      [ -n "$gate_target" ] && { rm -f "$gate_target" "$gate_target.parts"; echo "candor: --gate-json not written — the gate did not complete (exit 2)." >&2; }
      echo "candor: a crate's baseline files could not be loaded (see above) — the guard could NOT" >&2
      echo "candor: evaluate that crate; failing closed. Refresh with 'cargo candor snapshot $pre'" >&2
      echo "candor: and commit the baseline.* files." >&2
      exit 2
    fi
    # Final §3.3 verdict assembly, ONCE, over every crate's records — the engine's per-crate assembly
    # can race in a parallel workspace build; this one can't. Unwritable target ⇒ exit 2, never silent.
    if [ -n "$gate_target" ]; then
      if [ "$gjson" = "-" ]; then
        query gate-verdict "$gate_target.parts" - || { echo "candor: --gate-json verdict could not be assembled — failing closed." >&2; exit 2; }
        rm -rf "$gtmp"
      else
        query gate-verdict "$gate_target.parts" "$gate_target" || { echo "candor: --gate-json verdict could not be written to $gate_target — failing closed." >&2; exit 2; }
        rm -f "$gate_target.parts"
      fi
    fi
    if [ -s "$vio" ]; then
      echo "candor: a function GAINED an effect vs the baseline (AS-EFF-005) — blocked. Bypass: git push --no-verify" >&2
      exit 1
    fi
    exit 0 ;;

  diff)
    # The agent-facing sibling of `guard`: instead of pass/fail, DESCRIBE the per-function effect
    # delta vs the baseline — what each function gained or lost. This is the signal an agent can't
    # cheaply self-compute (transitive effects across the call graph). `--json` for machine reading.
    json=0; pre="${CANDOR_BASELINE:-${CFG_BASELINE:-.candor/baseline}}"
    for a in "$@"; do case "$a" in --json) json=1 ;; -*) ;; *) pre="$a" ;; esac; done
    if ! report_exists "$pre"; then
      echo "candor: no baseline at '$pre.*' — create one with 'cargo candor snapshot $pre'." >&2
      exit 2
    fi
    # FAST PATH: if the Stop hook (or `cargo candor watch`) already kept .candor/report.* fresh for
    # the CURRENT source, diff it directly — no recompile. The freshness test uses the SAME `src_state`
    # hash everything else does (content-based, so a stale report can never be mistaken for fresh; a
    # mismatch just falls back to the slow path).
    cur=""; rp=".candor/report"
    # FAST PATH applies only to a LINT report: `diff` compares against a lint baseline, so a fresh but
    # SCAN-produced `.candor/report` (e.g. the Stop hook ran the stable backend) must NOT be used as
    # `cur` — its under-reporting would mask a real effect regression as 'no change'. Fall to the slow
    # path (re-lint) when the cached report is a scan report.
    if report_exists "$rp" && [ -f .candor/state ] && ! is_scan_report "$rp"; then
      cur_hash="$(src_state)"
      [ -n "$cur_hash" ] && [ "$cur_hash" = "$(cat .candor/state 2>/dev/null)" ] && cur="$rp"
    fi
    if [ -z "$cur" ]; then
      # SLOW PATH: re-lint to a temp prefix (no fresh report available).
      tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
      [ "$json" = 1 ] || echo "candor: analyzing…" >&2
      run_json() { CANDOR_JSON="$tmp/cur" cargo dylint --lib-path "$LIB" >/dev/null 2>&1 || true; }
      run_json
      report_exists "$tmp/cur" || { rm -rf target/dylint 2>/dev/null || true; run_json; }
      if ! report_exists "$tmp/cur"; then
        echo "candor: no current report produced — did the crate build? Try 'cargo candor audit --all'." >&2
        exit 1
      fi
      cur="$tmp/cur"
    fi
    bv=""; [ -f "$pre.candor-version" ] && bv="$(cat "$pre.candor-version" 2>/dev/null)"
    query diff "$cur" "$pre" "$json" "$bv" "$(engine_ver)"
    exit 0 ;;

  watch)
    # Keep .candor/report.* fresh in the BACKGROUND so `cargo candor diff` (and the receipt) hit their
    # fast path — the compile then happens concurrently with editing, OFF the agent's critical path.
    # Polls the source hash (identically to candor-run.sh) every CANDOR_WATCH_INTERVAL s (default 2)
    # and re-lints on a real change. Long-running: run it in a side terminal, or `cargo candor watch &`.
    mkdir -p .candor
    sh_hash() { src_state; }
    last=""; cleared=0
    if [ -f .candor/state ] && report_exists .candor/report && [ "$(sh_hash)" = "$(cat .candor/state 2>/dev/null)" ]; then
      last="$(sh_hash)"; cleared=1   # warm cache, report already fresh
      echo "candor: report already fresh — watching $PWD (Ctrl-C to stop)…" >&2
    else
      echo "candor: watching $PWD for Rust changes (Ctrl-C to stop)…" >&2
    fi
    while true; do
      cur="$(sh_hash)"
      if [ -n "$cur" ] && [ "$cur" != "$last" ]; then
        [ "$cleared" = 0 ] && { rm -rf target/dylint 2>/dev/null || true; cleared=1; }   # cold cache → force the first emit
        clear_scan_reports "$PWD/.candor/report"   # drop any stale scan report so lint+scan never coexist
        if CANDOR_JSON="$PWD/.candor/report" cargo dylint --lib-path "$LIB" >/dev/null 2>&1 \
           && report_exists .candor/report; then
          echo "$cur" > .candor/state                      # stamp ONLY on a successful build → fresh
          echo "candor: report fresh @${cur:0:8}" >&2
        else
          echo "candor: build failed / no report — state left stale; retrying on next change" >&2
        fi
        last="$cur"
      fi
      sleep "${CANDOR_WATCH_INTERVAL:-2}"
    done ;;

  scan)
    # The STABLE backend: produce a candor report with NO nightly toolchain, dylint, or rustc_private —
    # a syntactic scan (candor-scan) that shares the lint's classifier. This is the zero-friction path:
    # `cargo candor scan` works on stock stable Rust, anywhere. It writes .candor/report.<crate>.scan.json
    # (+ a callgraph sidecar), so every read-only query (show/where/callers/map) then works against it,
    # exactly as they do against the lint's report. Precision is lower than the lint (it under-reports
    # resolution-heavy effects and does NOT emit Unknown) — see `candor-scan --help`. Args pass through
    # (e.g. `cargo candor scan path/to/crate --json`); default scans `.` to `.candor/report`.
    json=0; for a in "$@"; do [ "$a" = "--json" ] && json=1; done
    mkdir -p .candor
    scan_run "$@"
    # On a file-writing run (not --json-to-stdout), stamp source state so the staleness check (shared
    # with the lint path) can fire after later edits, and refresh whichever read-only report it wrote.
    [ "$json" = 1 ] || src_state > .candor/state 2>/dev/null || true
    exit 0 ;;

  show)
    # INSTANT: a function's effect surface, read from the fresh report (no recompile). Replaces the
    # agent reading source to answer "what does this function do?". `--json` for machine reading.
    json=0; q=""
    for a in "$@"; do case "$a" in --json) json=1 ;; -*) ;; *) [ -z "$q" ] && q="$a" ;; esac; done
    [ -n "$q" ] || { echo "usage: cargo candor show <function-name-substring> [--json]" >&2; exit 2; }
    ensure_report || exit 1
    query show .candor/report "$q" "$json"
    exit 0 ;;

  where)
    # INSTANT: which functions perform an effect, read from the fresh report (no recompile). Replaces
    # grepping the codebase for "what touches the network/DB/…". Splits sources from inheritors.
    json=0; eff=""
    for a in "$@"; do case "$a" in --json) json=1 ;; -*) ;; *) [ -z "$eff" ] && eff="$a" ;; esac; done
    [ -n "$eff" ] || { echo "usage: cargo candor where <Effect> [--json]   (Net|Fs|Db|Exec|Env|Clock|Ipc|Log|Rand|Clipboard|Unknown)" >&2; exit 2; }
    ensure_report || exit 1
    query where .candor/report "$eff" "$json"
    exit 0 ;;

  callers)
    # INSTANT: which functions directly call <fn>, read from the report's (effect-relevant) call
    # graph — replaces grepping the codebase for callers before you edit. Substring match on the name.
    json=0; q=""
    for a in "$@"; do case "$a" in --json) json=1 ;; -*) ;; *) [ -z "$q" ] && q="$a" ;; esac; done
    [ -n "$q" ] || { echo "usage: cargo candor callers <function-name-substring> [--json]" >&2; exit 2; }
    ensure_report || exit 1
    query callers .candor/report "$q" "$json"
    exit 0 ;;

  map)
    # INSTANT: a compact module -> effects overview of the whole project, read from the report. Load
    # it once at the start of a session to understand the codebase's effect structure without grepping.
    json=0; for a in "$@"; do [ "$a" = "--json" ] && json=1; done
    ensure_report || exit 1
    query map .candor/report "$json"
    exit 0 ;;

  containment)
    # Effect-LEAKAGE diagnostic: how well each boundary effect (Db/Net/Exec/Fs/Ipc) stays in one layer
    # — the architecture-quality signal counts can't give. With a baseline PREFIX it's a ratchet: exit 1
    # if a boundary effect leaks into a new layer, and note when one is cleaned up. `--json` for machines.
    #   cargo candor containment                    # the diagnostic
    #   cargo candor containment .candor/baseline   # gate vs a committed snapshot (for CI)
    cargs=(.candor/report)
    for a in "$@"; do case "$a" in --json) cargs+=("--json") ;; -*) ;; *) cargs+=("$a") ;; esac; done
    ensure_report || exit 1
    # Explicit exit-code propagation (a ratchet violation is candor-query's exit 1): don't lean on
    # `set -e` aborting mid-function to carry the status out — make the gate's verdict deliberate.
    rc=0; query containment "${cargs[@]}" || rc=$?
    exit "$rc" ;;

  reachable)
    # What the program PERFORMS at runtime: the union of effects over the entry points (main /
    # #[no_mangle] here; the whole reflective surface on the JVM port). `inferred` is already
    # transitive, so a root's set is its full reachable surface. `--json` for machines.
    #   cargo candor reachable
    rargs=(.candor/report)
    for a in "$@"; do case "$a" in --json) rargs+=("--json") ;; -*) ;; *) rargs+=("$a") ;; esac; done
    ensure_report || exit 1
    query reachable "${rargs[@]}"
    exit 0 ;;

  path)
    # Effect PROVENANCE: the call chain by which <fn> comes to perform <Effect> — the shortest path over
    # the effect-relevant call graph to the direct source. Answers "this performs Net, through what?".
    #   cargo candor path my_function Net
    json=""; pargs=()
    for a in "$@"; do case "$a" in --json) json="--json" ;; -*) ;; *) pargs+=("$a") ;; esac; done
    ensure_report || exit 1
    query path .candor/report "${pargs[@]}" ${json:+$json}
    exit 0 ;;

  impact)
    # Blast RADIUS: every effectful fn that transitively calls <fn>, and which entry points are
    # downstream — "if I change this, what surfaces at runtime?". The backward dual of `path`.
    #   cargo candor impact my_function
    json=""; iargs=()
    for a in "$@"; do case "$a" in --json) json="--json" ;; -*) ;; *) iargs+=("$a") ;; esac; done
    ensure_report || exit 1
    query impact .candor/report "${iargs[@]}" ${json:+$json}
    exit 0 ;;

  whatif)
    # PRE-EDIT verdict: "if I add <Effect> to <fn>, what propagates and does it break policy?" — the
    # blast radius (every transitive caller gains the effect) crossed with the deny/pure gate, computed
    # BEFORE you write the code instead of edit -> run the gate -> revert. Exit 1 if it would violate.
    #   cargo candor whatif my_function Net            # uses .candor/policy or $CANDOR_POLICY if present
    #   cargo candor whatif my_function Net rules.txt  # against an explicit policy file
    json=""; wargs=()
    for a in "$@"; do case "$a" in --json) json="1" ;; -*) ;; *) wargs+=("$a") ;; esac; done
    [ "${#wargs[@]}" -ge 2 ] || { echo "usage: cargo candor whatif <fn> <Effect> [policy-file] [--json]" >&2; exit 2; }
    ensure_report || exit 1
    # default the policy to the conventional .candor/policy when the caller didn't name one
    [ "${#wargs[@]}" -eq 2 ] && [ -f .candor/policy ] && wargs+=(".candor/policy")
    query whatif .candor/report "${wargs[@]}" ${json:+"$json"}
    exit "$?" ;;

  rewire)
    # DE-WIRING detector: which functions DROPPED a call they made in the baseline. The effect gate
    # (policy/whatif) checks effect BOUNDARIES, not correctness — it can be satisfied by *disconnecting*
    # functionality (an agent "fixes" a `deny Net api` violation by making api stop calling the offending
    # chain; the gate passes, the feature is broken). Run alongside `policy`: a green gate PLUS dropped
    # edges = verify a fix didn't gut the feature. Baseline = a prior scan's report prefix (e.g. of HEAD).
    #   cargo candor scan ../pre-edit-copy && cargo candor rewire ../pre-edit-copy/.candor/report
    json=""; base=""
    for a in "$@"; do case "$a" in --json) json="1" ;; -*) ;; *) [ -z "$base" ] && base="$a" ;; esac; done
    [ -n "$base" ] || { echo "usage: cargo candor rewire <baseline-report-prefix> [--json]  (a prior scan's .candor/report)" >&2; exit 2; }
    ensure_report || exit 1
    query rewire .candor/report "$base" ${json:+"$json"}
    exit "$?" ;;

  explain)
    # Trace WHY a function has each effect: the call path from it to the source of each effect (the
    # leaf call + location). `<query>` is a substring of the fully-qualified function name.
    q="${1:-}"
    [ -n "$q" ] || { echo "usage: cargo candor explain <function-name-substring>" >&2; exit 2; }
    lint_fresh CANDOR_EXPLAIN="$q" \
      | grep -vaE '^ *(Checking|Compiling|Finished|Building|Blocking|Locking|Updating|Downloading|Downloaded|Fresh) ' \
      | grep -vaE '^(warning|error)[:[]' \
      | grep -vaE 'generated [0-9]+ warning'
    exit 0 ;;

  policy)
    # Enforce declared effect boundaries (default .candor/policy). Fails (exit 1) on AS-EFF-006 (a
    # function that *transitively* performs an effect a rule forbids — e.g. domain code reaching the
    # network through a helper) or AS-EFF-008 (a function in scope reaching a Net host outside its
    # declared allowlist, or an endpoint candor can't pin down). Rules: `deny <Effects...> [scope]`,
    # `pure [scope]`, `allow Net [in <scope>] <host>...`; scope = a path substring. This is the
    # architectural-invariant gate an agent can't self-check.
    # Args: an optional policy file + `--gate-json <path|->` (the §3.3 structured verdict, spec ⟨0.8⟩ —
    # same shape as candor-scan's flag; `-` streams it to stdout).
    pol=""; gjson=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --gate-json)
          shift
          { [ "$#" -gt 0 ] && { [ "$1" = "-" ] || [ "${1#-}" = "$1" ]; }; } \
            || { echo "candor: --gate-json requires a path argument" >&2; exit 2; }
          gjson="$1" ;;
        -*) echo "candor: unknown flag '$1' for policy" >&2; exit 2 ;;
        *)  pol="$1" ;;
      esac
      shift
    done
    # Precedence (spec §3.4): the positional arg → $CANDOR_POLICY → .candor/config's `policy` key →
    # the conventional .candor/policy.
    [ -n "$pol" ] || pol="${CANDOR_POLICY:-}"
    [ -n "$pol" ] || pol="${CFG_POLICY:-}"
    [ -n "$pol" ] || pol=".candor/policy"
    [ -f "$pol" ] || { echo "candor: no policy at '$pol'. Rules: 'deny Net Db domain', 'pure parse', 'allow Net in billing api.stripe.com', 'forbid domain -> infra'." >&2; exit 2; }
    # Workspace-scale, one command. First SNAPSHOT every crate's report (dylint lints all workspace
    # members in one pass), so a boundary can see effects/hosts that physically live in a SIBLING crate.
    # Then ENFORCE with those siblings loaded read-only (CANDOR_REPORTS) — host allowlists and effect
    # boundaries now resolve across the crate graph, not just within the crate being checked.
    tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
    snap() { CANDOR_JSON="$tmp/r" cargo dylint --lib-path "$LIB" >/dev/null 2>&1 || true; }
    snap
    report_exists "$tmp/r" || { rm -rf target/dylint 2>/dev/null || true; snap; }
    # No snapshot ⇒ the crate didn't build (or the engine broke): enforcing anyway would run with NO
    # sibling reports loaded, so a cross-crate `allow` host / boundary silently goes unenforced — and a
    # total build failure would fall through to "policy OK". Fail closed (exit 2, policy NOT evaluated).
    if ! report_exists "$tmp/r"; then
      echo "candor: policy NOT evaluated — the report snapshot produced no reports (did the crate" >&2
      echo "candor: build?). Failing closed (exit 2); run 'cargo candor audit --all' to see errors." >&2
      exit 2
    fi
    # The snapshot warmed cargo's check cache; the CANDOR_* env vars aren't part of cargo's build
    # fingerprint, so a plain re-run would be a cache hit that never re-emits diagnostics. Clear
    # target/dylint so the enforce pass definitely re-runs the lint (with the siblings loaded).
    rm -rf target/dylint 2>/dev/null || true
    # The verdict rides on a MACHINE signal (CANDOR_VIOLATIONS), not on grepping the diagnostic prose:
    # the engine appends one line per AS-EFF-006/008/009 violation to this file, so a message reword or
    # a dylint output-stream change can't silently turn the gate green. We still print the human text.
    # Fresh file per run (engine appends; a stale one would false-fail). `: >` truncates/creates.
    vio="$tmp/violations"; : > "$vio"
    # The §3.3 verdict target (empty = not requested; the engine ignores an empty CANDOR_GATE_JSON).
    # Cleared up front so an exit-2 path can never leave a STALE verdict from a previous run.
    gate_target=""
    if [ -n "$gjson" ]; then
      case "$gjson" in -|/*) ;; *) gjson="$PWD/$gjson" ;; esac
      if [ "$gjson" = "-" ]; then gate_target="$tmp/gate.json"; else gate_target="$gjson"; fi
      rm -f "$gate_target" "$gate_target.parts"
    fi
    rc=0
    out="$(env CANDOR_POLICY="$pol" CANDOR_REPORTS="$tmp/r" CANDOR_VIOLATIONS="$vio" CANDOR_GATE_JSON="$gate_target" cargo dylint --lib-path "$LIB" 2>&1)" || rc=$?
    printf '%s\n' "$out" | grep -aE '\[AS-EFF-006\]|\[AS-EFF-008\]|\[AS-EFF-009\]' >&2 || true
    # A nonzero dylint exit is NEVER a violation verdict (the engine reports violations via the sentinel
    # and diagnostics, not the exit code): it means the enforce pass could not run to completion — a
    # build failure mid-workspace, or the engine's own §6.2 fail-closed exit 2 (an unreadable policy).
    # The old `|| true` swallowed it and printed "policy OK" (fail-open, the cardinal class). Mirror
    # `guard`: fail closed.
    if [ "$rc" -ne 0 ]; then
      printf '%s\n' "$out" >&2
      [ -n "$gate_target" ] && { rm -f "$gate_target" "$gate_target.parts"; echo "candor: --gate-json not written — the gate did not complete (exit 2)." >&2; }
      echo "candor: policy NOT evaluated (cargo dylint exited $rc — a build failure, or the engine's" >&2
      echo "candor: unreadable-policy fail-closed exit) — failing closed (exit 2), not a pass." >&2
      exit 2
    fi
    # Final §3.3 verdict assembly, ONCE, over every crate's records — the engine's per-crate assembly
    # can race in a parallel workspace build; this one can't. Unwritable target ⇒ exit 2, never silent.
    if [ -n "$gate_target" ]; then
      if [ "$gjson" = "-" ]; then
        query gate-verdict "$gate_target.parts" - || { echo "candor: --gate-json verdict could not be assembled — failing closed." >&2; exit 2; }
      else
        query gate-verdict "$gate_target.parts" "$gate_target" || { echo "candor: --gate-json verdict could not be written to $gate_target — failing closed." >&2; exit 2; }
        rm -f "$gate_target.parts"
      fi
    fi
    if [ -s "$vio" ]; then
      echo "candor: architecture-policy violation (AS-EFF-006/008/009) — blocked. Bypass: git push --no-verify" >&2
      exit 1
    fi
    echo "candor: policy OK — no boundary violations." >&2
    exit 0 ;;

  risk)
    # Heuristic: flag injection-class effects (Fs/Exec/Db/Net/Env/Ipc) performed on a PARAMETER-derived
    # argument — path traversal / command injection / SSRF. ADVISORY (exit 0): an intraprocedural,
    # syntactic nudge, NOT sound taint analysis — it over- and under-flags. Review it, don't gate on it.
    out="$(lint_fresh CANDOR_TAINT=1)"
    if printf '%s' "$out" | grep -q 'AS-EFF-007'; then
      printf '%s\n' "$out" | grep -aE '\[AS-EFF-007\]' >&2
      echo "candor: ^ heuristic review nudges (caller-derived effect arguments) — not a gate." >&2
    else
      echo "candor: no caller-derived effect arguments found (heuristic)." >&2
    fi
    exit 0 ;;

  update)
    # The clone is the single source of truth for the engine, the Claude Code integration
    # scripts, and AGENTS.md — pull + rebuild updates all three at one commit.
    echo "candor: updating $CANDOR_DIR …" >&2
    ( cd "$CANDOR_DIR" && git pull --ff-only ) >&2
    # One build+stash+symlink path, shared with `setup` — don't re-implement it here.
    "$CANDOR_DIR/install.sh" >&2
    LIB="$(find_lib || true)"; ev="$(engine_ver)"
    echo "candor: engine now @$ev — scripts and AGENTS.md current too." >&2
    # Invalidate the cached read-only query report: it was produced by the OLD engine, but `.candor/state`
    # still matches the (unchanged) source, so the query/diff fast-path would serve a stale-engine report
    # against the new-engine baseline → spurious reclassification deltas. Clearing it forces a rebuild
    # with the new engine on next use.
    rm -f .candor/report.*.*.json .candor/state 2>/dev/null || true
    # Auto-refresh a baseline in THIS project so the guard never false-fires after an
    # upgrade. Force a recompile (dylint emits only on recompile), regenerate, re-stamp.
    if ls .candor/baseline.*.json >/dev/null 2>&1; then
      pre=".candor/baseline"
      old="$(cat "$pre".*.json 2>/dev/null | shasum 2>/dev/null | cut -d' ' -f1)"
      find . -path ./target -prune -o -name '*.rs' -print0 2>/dev/null | xargs -0 touch 2>/dev/null || true
      if CANDOR_JSON="$pre" cargo dylint --lib-path "$LIB" >/dev/null 2>&1 && ls "$pre".*.json >/dev/null 2>&1; then
        echo "$ev" > "$pre.candor-version"
        rm -f "$(dirname "$pre")/review-seen" 2>/dev/null || true   # new baseline → reset §2 self-review
        new="$(cat "$pre".*.json 2>/dev/null | shasum 2>/dev/null | cut -d' ' -f1)"
        if [ "$old" = "$new" ]; then
          echo "candor: baseline content UNCHANGED (this engine classifies it identically) — re-stamped @$ev, nothing to review." >&2
        else
          echo "candor: baseline CHANGED under @$ev — the new engine detects different effects here." >&2
          echo "candor: review 'git diff .candor/' and commit it (this is the upgrade's doing, not a code change)." >&2
        fi
      else
        echo "candor: this project didn't compile — baseline NOT refreshed; the guard stays fail-open" >&2
        echo "candor: (and says so at push) until it builds and you re-run this." >&2
      fi
    else
      echo "candor: (no guard baseline in $PWD — run from a project dir to refresh that project's baseline)" >&2
    fi
    exit 0 ;;

  setup|install)
    # One-shot: build, stash the dylib + query binary in ~/.candor (survives `cargo clean`), and put
    # `cargo candor` on PATH via ~/.cargo/bin. Re-run any time to refresh.
    exec "$CANDOR_DIR/install.sh" "$@" ;;

  -h|--help|help)
    sed -n '2,21p' "$SELF" | sed 's/^# \{0,1\}//'
    exit 0 ;;
  *)
    echo "candor: unknown command '$cmd' (setup|scan|audit|snapshot|guard|diff|watch|show|where|callers|whatif|rewire|map|explain|policy|risk|strict|no-ambient|update)" >&2
    exit 2 ;;
esac
