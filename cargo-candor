#!/usr/bin/env bash
# cargo-candor — ergonomic wrapper around `cargo dylint` for the candor lint.
#
# Put this file's directory on PATH (or symlink this file into one), then run e.g.
#   cargo candor audit              # at-a-glance effect profile of the whole project
#   cargo candor audit --all        # the full per-function lint (spans in context)
#   cargo candor snapshot .candor/baseline
#   cargo candor guard    .candor/baseline   # CI gate: fail on a gained effect
#   cargo candor diff     .candor/baseline   # describe the per-function effect delta (--json)
#   cargo candor watch                        # keep the report fresh in the background (fast `diff`)
#   cargo candor explain  my_function        # trace WHY a function has each effect (the call path)
#   cargo candor policy   .candor/policy      # enforce effect boundaries (deny/pure rules)
#   cargo candor risk                         # heuristic: effects on caller-derived input (advisory)
#   cargo candor update
#   cargo candor strict   my_module
#   cargo candor no-ambient my_module
#
# It locates (building on first use) the toolchain-suffixed candor dylib and invokes
# `cargo dylint --lib-path <dylib>` with the right environment for the chosen command.
set -euo pipefail

# Resolve the candor repo — this script lives at its root (follow symlinks).
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do SELF="$(cd "$(dirname "$SELF")" && pwd)/$(readlink "$SELF")"; done
CANDOR_DIR="$(cd "$(dirname "$SELF")" && pwd)"

find_lib() {
  ls "$CANDOR_DIR"/target/debug/libcandor@*.dylib \
     "$CANDOR_DIR"/target/debug/libcandor@*.so 2>/dev/null | head -1
}

LIB="$(find_lib || true)"
if [ -z "${LIB:-}" ]; then
  echo "candor: building the lint (first run)…" >&2
  ( cd "$CANDOR_DIR" && cargo build >&2 )
  LIB="$(find_lib || true)"
fi
[ -n "${LIB:-}" ] || {
  echo "candor: could not build/find the lint dylib under $CANDOR_DIR/target/debug" >&2
  exit 1
}

# Cargo invokes external subcommands as `cargo-candor candor …`; drop the leading word.
[ "${1:-}" = "candor" ] && shift
cmd="${1:-audit}"; shift || true

# The candor commit that produced (or is checking) a baseline. A baseline is only comparable to
# itself — see `guard` and `update` below. Read the version the DYLIB was actually built at (the
# tag build.rs embedded), NOT the source tree's git HEAD: those diverge after `git pull` without a
# rebuild, and a HEAD-based check would then call a stale engine "current" and mask a stale
# baseline. Fall back to HEAD only if the tag can't be read (e.g. no `strings`).
engine_ver() {
  local v
  v="$(strings -a "$LIB" 2>/dev/null | grep -oE 'candor-build-version=[0-9a-fA-F]+' | head -1 | cut -d= -f2)"
  [ -n "$v" ] && { printf '%s' "$v"; return 0; }
  git -C "$CANDOR_DIR" rev-parse --short HEAD 2>/dev/null
}

case "$cmd" in
  audit)
    # `--all`/`-a` (or no python3) → the full per-function lint: the dylint-native view, spans in
    # context. Default → an at-a-glance profile, aggregated across the project's crates.
    if [ "${1:-}" = "--all" ] || [ "${1:-}" = "-a" ] || ! command -v python3 >/dev/null 2>&1; then
      exec cargo dylint --lib-path "$LIB"
    fi
    tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
    echo "candor: analyzing…" >&2
    run_json() { CANDOR_JSON="$tmp/a" cargo dylint --lib-path "$LIB" >/dev/null 2>&1 || true; }
    run_json
    # dylint emits only on recompile; if nothing was written the build was cached — force it once.
    ls "$tmp"/a.*.*.json >/dev/null 2>&1 || { rm -rf target/dylint 2>/dev/null || true; run_json; }
    if ! ls "$tmp"/a.*.*.json >/dev/null 2>&1; then
      echo "candor: no report produced — did the crate build? Try 'cargo candor audit --all' to see errors." >&2
      exit 1
    fi
    python3 - "$tmp/a" "$(engine_ver)" <<'PY'
import sys, os, glob, json, re
pre, ver = sys.argv[1], sys.argv[2]
base = os.path.basename(pre)

def entries(path):
    try: d = json.load(open(path))
    except Exception: return []
    if isinstance(d, dict) and isinstance(d.get('functions'), list): return d['functions']   # v0.2 envelope
    return d if isinstance(d, list) else []                                                   # v0.1 bare array

fns, percrate = [], []
for f in sorted(glob.glob(pre + '.*.*.json')):
    es = entries(f); fns += es
    percrate.append((os.path.basename(f)[len(base)+1:-5], len(es)))   # <crate>.<type>

if not fns:
    print("candor: no effectful functions found (everything candor can see is pure)."); sys.exit(0)

EFFS = ['Net','Db','Fs','Exec','Ipc','Env','Clock','Rand','Clipboard','Log']
tally = {e: 0 for e in EFFS}; unresolved = []
for e in fns:
    inf = e.get('inferred', [])
    for x in inf:
        if x in tally: tally[x] += 1
    if e.get('unresolved') or 'Unknown' in inf: unresolved.append(e['fn'])

print(f"candor @{ver}")
print(f"{len(fns)} effectful functions  ·  " + ' · '.join(f"{n} {k}" for k, n in percrate))
print()
ranked = sorted(((tally[e], e) for e in EFFS if tally[e]), reverse=True)
print("  effects   " + ' · '.join(f"{n} {e}" for n, e in ranked))
print()

if unresolved:
    u = sorted(set(unresolved))
    extra = f"  (+{len(u)-5} more)" if len(u) > 5 else ""
    print(f"  ⚠ {len(u)} make calls candor can't resolve — their effect set may be incomplete (read these):")
    print("      " + ", ".join(u[:5]) + extra)
    print()

# coverage: external crates candor saw called but does not calibrate, that LOOK effectful.
# (SUSPECT mirrors integrations/claude-code/candor-run.sh — a nudge heuristic, not a guarantee.)
calib_c, calib_p = set(), set()
try:
    cj = json.load(open(os.path.join(os.path.dirname(pre) or ".", base + ".calibrated.json")))
    calib_c, calib_p = set(cj.get("crates", [])), set(cj.get("prefixes", []))
except Exception: pass
seen = set()
for f in glob.glob(pre + '.encountered-*.json'):
    try: seen |= set(json.load(open(f)))
    except Exception: pass
SUSPECT = re.compile(r'sql|sqlite|postgres|mysql|mariadb|mongo|redis|cassandra|scylla|cockroach|dynamo'
                     r'|surreal|diesel|sea_?orm|tiberius|oracle|clickhouse|influx|neo4j|hyper|surf|curl'
                     r'|reqwest|isahc|ureq|http|grpc|tonic|websocket|tungstenite|smtp|lettre|imap|ftp|ssh'
                     r'|nats|kafka|rdkafka|pulsar|amqp|lapin|rabbit|mqtt|rumqtt|zmq|etcd|consul|elastic'
                     r'|meili|minio|^s3|aws|azure|gcp|google_?cloud')
def calibrated(c):
    return c in calib_c or any(c == k or c.startswith(k + "_") for k in calib_c) or any(c.startswith(p) for p in calib_p)
gaps = sorted(c for c in seen if SUSPECT.search(c) and not calibrated(c))
if gaps:
    print(f"  ⚠ coverage: {', '.join(gaps)} uncalibrated — effects through them may be under-counted")
    print()

# the functions with the widest reach into the outside world — the ones worth knowing about.
def width(e): return len([x for x in e.get('inferred', []) if x != 'Unknown'])
top = sorted((e for e in fns if width(e) > 0), key=lambda e: (-width(e), e['fn']))[:8]
if top:
    w = max(len(e['fn']) for e in top)
    print("  broadest effect surface")
    for e in top:
        effs = sorted(x for x in e['inferred'] if x != 'Unknown')
        print(f"    {e['fn']:<{w}}  {{ {' '.join(effs)} }}")
    print()

print("  full per-function view:  cargo candor audit --all")
print("  guard against new effects:  cargo candor snapshot .candor/baseline")
PY
    exit 0 ;;
  strict)     export CANDOR_STRICT="${1:-1}";      exec cargo dylint --lib-path "$LIB" ;;
  no-ambient) export CANDOR_NO_AMBIENT="${1:-1}";  exec cargo dylint --lib-path "$LIB" ;;

  snapshot)
    # Write the baseline AND stamp the engine version beside it, so the guard later
    # knows which candor produced it.
    pre="${1:-.candor/baseline}"
    mkdir -p "$(dirname "$pre")"
    CANDOR_JSON="$pre" cargo dylint --lib-path "$LIB"
    engine_ver > "$pre.candor-version"
    rm -f "$(dirname "$pre")/review-seen" 2>/dev/null || true   # new baseline → reset §2 self-review
    echo "candor: baseline written and stamped @$(cat "$pre.candor-version" 2>/dev/null)." >&2
    exit 0 ;;

  guard)
    # A baseline is only valid for the candor version that made it. If the engine has
    # moved on, a richer classifier would report effects the old snapshot never saw —
    # which is NOT a code regression. So on a version mismatch we SKIP enforcement (never
    # false-fire) and tell the user how to refresh; `cargo candor update` does it for them.
    pre="${1:-.candor/baseline}"
    ev="$(engine_ver)"; bv=""
    [ -f "$pre.candor-version" ] && bv="$(cat "$pre.candor-version" 2>/dev/null)"
    if [ -n "$bv" ] && [ "$bv" != "$ev" ]; then
      echo "candor: baseline is @$bv but the engine is @$ev — a tool upgrade is not a code" >&2
      echo "candor: regression, so effect enforcement is SKIPPED this run. Refresh it with" >&2
      echo "candor: 'cargo candor update' (or 'cargo candor snapshot $pre') here, then commit." >&2
      exit 0
    fi
    out="$(CANDOR_BASELINE="$pre" cargo dylint --lib-path "$LIB" 2>&1 || true)"
    printf '%s\n' "$out" >&2
    if printf '%s' "$out" | grep -q 'AS-EFF-005'; then
      echo "candor: a function GAINED an effect vs the baseline (AS-EFF-005) — blocked. Bypass: git push --no-verify" >&2
      exit 1
    fi
    exit 0 ;;

  diff)
    # The agent-facing sibling of `guard`: instead of pass/fail, DESCRIBE the per-function effect
    # delta vs the baseline — what each function gained or lost. This is the signal an agent can't
    # cheaply self-compute (transitive effects across the call graph). `--json` for machine reading.
    json=0; pre=".candor/baseline"
    for a in "$@"; do case "$a" in --json) json=1 ;; -*) ;; *) pre="$a" ;; esac; done
    command -v python3 >/dev/null 2>&1 || { echo "candor: diff needs python3" >&2; exit 2; }
    if ! ls "$pre".*.*.json >/dev/null 2>&1; then
      echo "candor: no baseline at '$pre.*' — create one with 'cargo candor snapshot $pre'." >&2
      exit 2
    fi
    # FAST PATH: if the Stop hook (or `cargo candor watch`) already kept .candor/report.* fresh for
    # the CURRENT source, diff it directly — no recompile. The freshness test matches candor-run.sh's
    # src_hash exactly (find *.rs under $PWD, content-hash, compare to .candor/state). Content-based,
    # so a stale report can never be mistaken for fresh; a mismatch just falls back to the slow path.
    cur=""; rp=".candor/report"
    if ls "$rp".*.*.json >/dev/null 2>&1 && [ -f .candor/state ]; then
      cur_hash="$(find "$PWD" -name '*.rs' -not -path '*/target/*' -not -path '*/.git/*' -print0 2>/dev/null \
                  | sort -z | xargs -0 shasum 2>/dev/null | shasum 2>/dev/null | cut -d' ' -f1)"
      [ -n "$cur_hash" ] && [ "$cur_hash" = "$(cat .candor/state 2>/dev/null)" ] && cur="$rp"
    fi
    if [ -z "$cur" ]; then
      # SLOW PATH: re-lint to a temp prefix (no fresh report available).
      tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
      [ "$json" = 1 ] || echo "candor: analyzing…" >&2
      run_json() { CANDOR_JSON="$tmp/cur" cargo dylint --lib-path "$LIB" >/dev/null 2>&1 || true; }
      run_json
      ls "$tmp"/cur.*.*.json >/dev/null 2>&1 || { rm -rf target/dylint 2>/dev/null || true; run_json; }
      if ! ls "$tmp"/cur.*.*.json >/dev/null 2>&1; then
        echo "candor: no current report produced — did the crate build? Try 'cargo candor audit --all'." >&2
        exit 1
      fi
      cur="$tmp/cur"
    fi
    bv=""; [ -f "$pre.candor-version" ] && bv="$(cat "$pre.candor-version" 2>/dev/null)"
    python3 - "$cur" "$pre" "$json" "$bv" "$(engine_ver)" <<'PY'
import sys, glob, json as J
cur_pre, base_pre, want_json, bver, ever = sys.argv[1], sys.argv[2], sys.argv[3] == "1", sys.argv[4], sys.argv[5]

def load(pre):
    out = {}
    for f in glob.glob(pre + '.*.*.json'):
        try: d = J.load(open(f))
        except Exception: continue
        fns = d['functions'] if isinstance(d, dict) and isinstance(d.get('functions'), list) else d if isinstance(d, list) else []
        for e in fns:
            out[e['fn']] = {"inferred": set(e.get('inferred', [])), "direct": set(e.get('direct', []))}
    return out

def inferred(m, fn): return m.get(fn, {}).get("inferred", set())
cur, base = load(cur_pre), load(base_pre)
changes = []
for fn in set(cur) | set(base):
    ci, bi = inferred(cur, fn), inferred(base, fn)
    if fn not in cur:                       # function gone (was in baseline)
        if bi: changes.append({"fn": fn, "gained": [], "introduced": [], "inherited": [], "lost": sorted(bi), "status": "removed"})
        continue
    gained = sorted(ci - bi)
    lost = sorted(bi - ci) if fn in base else []
    if not gained and not lost: continue
    # A gained effect is INTRODUCED here if it's in this function's own `direct` set; otherwise it's
    # INHERITED from a callee. That tells the agent the source vs. the blast radius.
    cd = cur[fn]["direct"]
    changes.append({
        "fn": fn, "gained": gained,
        "introduced": [e for e in gained if e in cd],
        "inherited":  [e for e in gained if e not in cd],
        "lost": lost,
        "status": "new" if fn not in base else "changed",
    })

if want_json:
    print(J.dumps({"baseline_version": bver, "engine_version": ever, "changes": changes}, indent=2))
    sys.exit(0)

if not changes:
    print(f"candor: no effect changes vs {base_pre} (@{bver or '?'})."); sys.exit(0)

print(f"candor diff — current (@{ever}) vs {base_pre} (@{bver or '?'})")
if bver and ever and bver != ever:
    print(f"  ⚠ baseline @{bver} ≠ engine @{ever} — some changes may be the engine reclassifying, not your code.")
print()
# Sources of a new effect first (where to fix), then inheritors, then pure drops.
changes.sort(key=lambda c: (0 if c["introduced"] else (1 if c["gained"] else 2), c["fn"]))
for c in changes:
    parts = [f"+{e}*" for e in c["introduced"]] + [f"+{e}" for e in c["inherited"]] + [f"-{e}" for e in c["lost"]]
    mark = "+" if c["gained"] else "-"
    tags = []
    if c["status"] == "new": tags.append("new fn")
    if c["status"] == "removed": tags.append("removed fn")
    if "Unknown" in c["gained"]: tags.append("⚠ now unresolvable")
    tag = ("  (" + ", ".join(tags) + ")") if tags else ""
    print(f"  {mark} {c['fn']}{tag}   {{ {' '.join(parts)} }}")
print()
print("  * = introduced in this function (the source of the new effect); unmarked + = inherited from a callee.")
for e in sorted({x for c in changes for x in c["gained"]}):
    srcs = sorted(c["fn"] for c in changes if e in c["introduced"])
    inhc = sum(1 for c in changes if e in c["inherited"])
    if srcs:
        print(f"  {e}: introduced in {', '.join(srcs)} → inherited by {inhc} caller(s).")
    elif inhc:
        print(f"  {e}: inherited by {inhc} function(s) (source is outside this crate or the baseline).")
if any("Unknown" in c["gained"] for c in changes):
    print("  ⚠ a new Unknown means candor can no longer prove that function's effect set is complete — review it.")
PY
    exit 0 ;;

  watch)
    # Keep .candor/report.* fresh in the BACKGROUND so `cargo candor diff` (and the receipt) hit their
    # fast path — the compile then happens concurrently with editing, OFF the agent's critical path.
    # Polls the source hash (identically to candor-run.sh) every CANDOR_WATCH_INTERVAL s (default 2)
    # and re-lints on a real change. Long-running: run it in a side terminal, or `cargo candor watch &`.
    command -v shasum >/dev/null 2>&1 || { echo "candor: watch needs shasum" >&2; exit 2; }
    mkdir -p .candor
    sh_hash() { find "$PWD" -name '*.rs' -not -path '*/target/*' -not -path '*/.git/*' -print0 2>/dev/null \
                | sort -z | xargs -0 shasum 2>/dev/null | shasum 2>/dev/null | cut -d' ' -f1; }
    last=""; cleared=0
    if [ -f .candor/state ] && ls .candor/report.*.*.json >/dev/null 2>&1 && [ "$(sh_hash)" = "$(cat .candor/state 2>/dev/null)" ]; then
      last="$(sh_hash)"; cleared=1   # warm cache, report already fresh
      echo "candor: report already fresh — watching $PWD (Ctrl-C to stop)…" >&2
    else
      echo "candor: watching $PWD for Rust changes (Ctrl-C to stop)…" >&2
    fi
    while true; do
      cur="$(sh_hash)"
      if [ -n "$cur" ] && [ "$cur" != "$last" ]; then
        [ "$cleared" = 0 ] && { rm -rf target/dylint 2>/dev/null || true; cleared=1; }   # cold cache → force the first emit
        if CANDOR_JSON="$PWD/.candor/report" cargo dylint --lib-path "$LIB" >/dev/null 2>&1 \
           && ls .candor/report.*.*.json >/dev/null 2>&1; then
          echo "$cur" > .candor/state                      # stamp ONLY on a successful build → fresh
          echo "candor: report fresh @${cur:0:8}" >&2
        else
          echo "candor: build failed / no report — state left stale; retrying on next change" >&2
        fi
        last="$cur"
      fi
      sleep "${CANDOR_WATCH_INTERVAL:-2}"
    done ;;

  explain)
    # Trace WHY a function has each effect: the call path from it to the source of each effect (the
    # leaf call + location). `<query>` is a substring of the fully-qualified function name.
    q="${1:-}"
    [ -n "$q" ] || { echo "usage: cargo candor explain <function-name-substring>" >&2; exit 2; }
    rm -rf target/dylint 2>/dev/null || true   # force a fresh lint so explain has the full call graph
    CANDOR_EXPLAIN="$q" cargo dylint --lib-path "$LIB" 2>&1 \
      | grep -vaE '^ *(Checking|Compiling|Finished|Building|Blocking|Locking|Updating|Downloading|Downloaded|Fresh) ' \
      | grep -vaE '^(warning|error)[:[]' \
      | grep -vaE 'generated [0-9]+ warning'
    exit 0 ;;

  policy)
    # Enforce declared effect boundaries (default .candor/policy). Fails (exit 1) on any AS-EFF-006 —
    # a function that *transitively* performs an effect a rule forbids (e.g. domain code reaching the
    # network through a helper). Rules: `deny <Effects...> [scope]`, `pure [scope]`; scope = a path
    # substring. This is the architectural-invariant gate an agent can't self-check.
    pol="${1:-.candor/policy}"
    [ -f "$pol" ] || { echo "candor: no policy at '$pol'. Write rules like 'deny Net Db domain' or 'pure parse'." >&2; exit 2; }
    rm -rf target/dylint 2>/dev/null || true   # force a fresh lint so the gate can't pass on a cache hit
    out="$(CANDOR_POLICY="$pol" cargo dylint --lib-path "$LIB" 2>&1 || true)"
    printf '%s\n' "$out" | grep -aE '\[AS-EFF-006\]' >&2 || true
    if printf '%s' "$out" | grep -q 'AS-EFF-006'; then
      echo "candor: effect-policy violation (AS-EFF-006) — blocked. Bypass: git push --no-verify" >&2
      exit 1
    fi
    echo "candor: policy OK — no boundary violations." >&2
    exit 0 ;;

  risk)
    # Heuristic: flag injection-class effects (Fs/Exec/Db/Net/Env/Ipc) performed on a PARAMETER-derived
    # argument — path traversal / command injection / SSRF. ADVISORY (exit 0): an intraprocedural,
    # syntactic nudge, NOT sound taint analysis — it over- and under-flags. Review it, don't gate on it.
    rm -rf target/dylint 2>/dev/null || true
    out="$(CANDOR_TAINT=1 cargo dylint --lib-path "$LIB" 2>&1 || true)"
    if printf '%s' "$out" | grep -q 'AS-EFF-007'; then
      printf '%s\n' "$out" | grep -aE '\[AS-EFF-007\]' >&2
      echo "candor: ^ heuristic review nudges (caller-derived effect arguments) — not a gate." >&2
    else
      echo "candor: no caller-derived effect arguments found (heuristic)." >&2
    fi
    exit 0 ;;

  update)
    # The clone is the single source of truth for the engine, the Claude Code integration
    # scripts, and AGENTS.md — pull + rebuild updates all three at one commit.
    echo "candor: updating $CANDOR_DIR …" >&2
    ( cd "$CANDOR_DIR" && git pull --ff-only && cargo build ) >&2
    LIB="$(find_lib || true)"; ev="$(engine_ver)"
    echo "candor: engine now @$ev — scripts and AGENTS.md current too." >&2
    # Auto-refresh a baseline in THIS project so the guard never false-fires after an
    # upgrade. Force a recompile (dylint emits only on recompile), regenerate, re-stamp.
    if ls .candor/baseline.*.json >/dev/null 2>&1; then
      pre=".candor/baseline"
      old="$(cat "$pre".*.json 2>/dev/null | shasum 2>/dev/null | cut -d' ' -f1)"
      find . -path ./target -prune -o -name '*.rs' -print0 2>/dev/null | xargs -0 touch 2>/dev/null || true
      if CANDOR_JSON="$pre" cargo dylint --lib-path "$LIB" >/dev/null 2>&1 && ls "$pre".*.json >/dev/null 2>&1; then
        echo "$ev" > "$pre.candor-version"
        rm -f "$(dirname "$pre")/review-seen" 2>/dev/null || true   # new baseline → reset §2 self-review
        new="$(cat "$pre".*.json 2>/dev/null | shasum 2>/dev/null | cut -d' ' -f1)"
        if [ "$old" = "$new" ]; then
          echo "candor: baseline content UNCHANGED (this engine classifies it identically) — re-stamped @$ev, nothing to review." >&2
        else
          echo "candor: baseline CHANGED under @$ev — the new engine detects different effects here." >&2
          echo "candor: review 'git diff .candor/' and commit it (this is the upgrade's doing, not a code change)." >&2
        fi
      else
        echo "candor: this project didn't compile — baseline NOT refreshed; the guard stays fail-open" >&2
        echo "candor: (and says so at push) until it builds and you re-run this." >&2
      fi
    else
      echo "candor: (no guard baseline in $PWD — run from a project dir to refresh that project's baseline)" >&2
    fi
    exit 0 ;;

  -h|--help|help)
    sed -n '2,19p' "$SELF" | sed 's/^# \{0,1\}//'
    exit 0 ;;
  *)
    echo "candor: unknown command '$cmd' (audit|snapshot|guard|diff|watch|explain|policy|risk|strict|no-ambient|update)" >&2
    exit 2 ;;
esac
